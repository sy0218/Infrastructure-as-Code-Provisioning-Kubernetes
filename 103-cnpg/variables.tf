# ===============================================
# [ variables.tf ]
#   - Terraform 에서 사용할 입력 변수 정의
#   - 실제 값은 terraform.tfvars 에서 전달
#   - 설정값을 직접 하드코딩 않고 변수로 분리
# ===============================================


# -----------------------------------------------
# [클러스터 접속]
# -----------------------------------------------
# → Terraform이 Kubernetes 클러스터에 접속할 때 사용하는 설정 파일이다.
variable "kubeconfig_path" {
  description = "kubeconfig 파일 경로"
  type        = string
}

# -----------------------------------------------
# [차트 버전]
# -----------------------------------------------
variable "cnpg_chart_version" {
  description = "cloudnative-pg 차트 버전"
  type        = string
}

# -----------------------------------------------
# [네임스페이스]
# -----------------------------------------------
variable "namespace" {
  description = "CloudNativePG 오퍼레이터 네임스페이스"
  type        = string
}