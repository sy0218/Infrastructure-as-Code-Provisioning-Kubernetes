# ===============================================
# [Airflow dag-processor]
#   → DAG 파싱 결과를 메타DB 에 쓰는 컴포넌트.
#   → 공통 규약(args/securityContext/checksum/envFrom)은 apiserver 템플릿 배너 참조.
#   ⚠ DAG 은 이미지에 구워져 있다 — DAG 을 고치면 재빌드 → image_tag 변경 → 롤아웃이다.
# ===============================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: airflow-dag-processor
  namespace: ${namespace}
  labels:
    app: airflow-dag-processor
    app.kubernetes.io/name: airflow
    app.kubernetes.io/component: dag-processor
    app.kubernetes.io/part-of: data-layer
spec:
  replicas: ${replicas}
  selector:
    matchLabels:
      app: airflow-dag-processor
  # Recreate — 두 파드가 같은 DAG 을 동시에 파싱해 같은 행을 갱신할 이유가 없다
  # (파싱 지연은 몇 초, 겹침의 이득은 0).
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: airflow-dag-processor
        app.kubernetes.io/name: airflow
        app.kubernetes.io/component: dag-processor
        app.kubernetes.io/part-of: data-layer
      annotations:
        checksum/airflow-env: "${config_hash}"
    spec:
      # Service env 자동 주입 차단 — 근거는 CLAUDE.md '쿠버네티스 규약'
      enableServiceLinks: false

      securityContext:
        runAsUser: ${run_as_user}
        runAsGroup: ${fs_group}
        fsGroup: ${fs_group}
      # ── 코드 전달: git-sync ────────────────────────────────────────────────
      # 이미지에는 DAG·커스텀 패키지가 없다(data_layer_airflow/Dockerfile 참조) —
      # 원본은 303-git 의 저장소이고, 이 두 컨테이너가 그것을 emptyDir 로 받아 온다.
      # 파드 securityContext(uid/gid)를 그대로 상속하므로 받아온 파일 소유자가 airflow 와
      # 같아 파싱 캐시(.pyc) 경고가 나지 않는다.
      #
      # ⚠ initContainer 를 빼지 말 것 — 사이드카만 두면 첫 fetch 전에 airflow 가 먼저 떠서
      #   'DAG 0개'로 조용히 기동한다.
      initContainers:
        - name: git-sync-init
          image: ${gitsync_image}
          env:
            - name: GITSYNC_REPO
              value: "${git_repo}"
            - name: GITSYNC_REF
              value: "${git_ref}"
            - name: GITSYNC_ROOT
              value: "/git"
            - name: GITSYNC_LINK
              value: "repo"
            - name: GITSYNC_ONE_TIME
              value: "true"
            # git 이 전역 설정을 쓰려 할 때 쓸 쓰기 가능한 HOME (uid 50000 은 홈이 없다)
            - name: HOME
              value: "/tmp"
          volumeMounts:
            - name: git-repo
              mountPath: /git

      containers:
        - name: dag-processor
          image: ${image}
          imagePullPolicy: IfNotPresent
          args: ["dag-processor"]
          envFrom:
            - configMapRef:
                name: data-layer-env
            - secretRef:
                name: data-layer-secrets
            - secretRef:
                name: airflow-env
          # HTTP 헬스 엔드포인트가 없어 exec 로 확인한다. `--local` 은 판정 범위를 이 파드의
          # job 으로 좁힌다 — 없으면 다른 파드의 하트비트를 보고 자기가 살아있다고 착각한다.
          # readiness 는 두지 않는다: 이 파드 앞에 Service 가 없어 '준비됨'이 바꾸는 게 없다.
          livenessProbe:
            exec:
              command:
                - /bin/bash
                - -c
                - airflow jobs check --job-type DagProcessorJob --local
            # 파이썬 프로세스를 새로 띄우는 probe 라 주기를 넉넉히 잡는다
            initialDelaySeconds: 60
            periodSeconds: 60
            timeoutSeconds: 30
            failureThreshold: 5
          resources:
            requests:
              cpu: "200m"
              memory: "512Mi"
          # DAGS_FOLDER 와 PYTHONPATH 가 이 경로를 가리킨다(Secret airflow-env).
          # ⚠ subPath 로 꽂지 말 것 — git-sync 가 갈아끼우는 심볼릭 링크를 따라가지 못해
          #   동기화가 영원히 반영되지 않는다(에러도 나지 않는다).
          volumeMounts:
            - name: git-repo
              mountPath: /git

        # 주기적으로 fetch 해 /git/repo 심볼릭 링크를 통째로 갈아끼운다 →
        # 반쯤 쓰인 파일이 파서에 노출되는 구간이 없다(원자적 교체).
        - name: git-sync
          image: ${gitsync_image}
          imagePullPolicy: IfNotPresent
          env:
            - name: GITSYNC_REPO
              value: "${git_repo}"
            - name: GITSYNC_REF
              value: "${git_ref}"
            - name: GITSYNC_ROOT
              value: "/git"
            - name: GITSYNC_LINK
              value: "repo"
            - name: GITSYNC_PERIOD
              value: "${git_sync_period}"
            - name: HOME
              value: "/tmp"
          volumeMounts:
            - name: git-repo
              mountPath: /git
          resources:
            requests:
              cpu: "10m"
              memory: "32Mi"
      volumes:
        - name: git-repo
          emptyDir: {}
