# ===============================================
# [Airflow api-server — UI / REST / Execution API]
#   → 4개 컴포넌트 공통 규약을 여기서 한 번만 적는다: command 를 덮지 않고 args 만 준다
#     (이미지 entrypoint 가 환경을 세팅한 뒤 인자를 airflow CLI 로 넘기는 구조),
#     securityContext 는 UID 50000 / 그룹 0, envFrom 은 공용 → airflow-env 순(뒤가 이긴다).
#   → checksum/airflow-env 어노테이션이 없으면 envFrom 값이 파드 재생성 없이 갱신되지 않아
#     "Secret 은 고쳤는데 동작은 그대로"가 된다.
# ===============================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: airflow-apiserver
  namespace: ${namespace}
  labels:
    app: airflow-apiserver
    app.kubernetes.io/name: airflow
    app.kubernetes.io/component: apiserver
    app.kubernetes.io/part-of: data-layer
spec:
  replicas: ${replicas}
  selector:
    matchLabels:
      app: airflow-apiserver
  # UI/REST 는 상태가 없고 여러 개가 동시에 떠도 무해하다 → 무중단 롤링
  # (나머지 3개는 Recreate — 각 템플릿 주석 참조)
  strategy:
    type: RollingUpdate
  template:
    metadata:
      labels:
        app: airflow-apiserver
        app.kubernetes.io/name: airflow
        app.kubernetes.io/component: apiserver
        app.kubernetes.io/part-of: data-layer
      annotations:
        checksum/airflow-env: "${config_hash}"
    spec:
      # Service env 자동 주입 차단 — 근거는 CLAUDE.md '쿠버네티스 규약'
      enableServiceLinks: false

      securityContext:
        runAsUser: ${run_as_user}
        runAsGroup: ${fs_group}
        fsGroup: ${fs_group}
      containers:
        - name: apiserver
          image: ${image}
          imagePullPolicy: IfNotPresent
          args: ["api-server"]
          ports:
            - name: http
              containerPort: ${apiserver_port}
          envFrom:
            - configMapRef:
                name: data-layer-env
            - secretRef:
                name: data-layer-secrets
            - secretRef:
                name: airflow-env
          readinessProbe:
            httpGet:
              path: /api/v2/monitor/health
              port: http
            initialDelaySeconds: 20
            periodSeconds: 10
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /api/v2/monitor/health
              port: http
            initialDelaySeconds: 60
            periodSeconds: 20
            failureThreshold: 6
          resources:
            requests:
              cpu: "250m"
              memory: "1Gi"
