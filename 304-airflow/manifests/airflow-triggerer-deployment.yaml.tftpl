# ===============================================
# [Airflow triggerer]
#   → deferrable 오퍼레이터용. 현재 DAG 엔 없지만 Airflow 3 표준 구성이라 함께 띄운다
#     (없는 상태에서 deferrable 을 쓰면 태스크가 영원히 deferred 로 멈춘다).
#   → 공통 규약(args/securityContext/checksum/envFrom)은 apiserver 템플릿 배너 참조.
# ===============================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: airflow-triggerer
  namespace: ${namespace}
  labels:
    app: airflow-triggerer
    app.kubernetes.io/name: airflow
    app.kubernetes.io/component: triggerer
    app.kubernetes.io/part-of: data-layer
spec:
  replicas: ${replicas}
  selector:
    matchLabels:
      app: airflow-triggerer
  # Recreate — 롤링 중 두 파드가 공존하면 같은 트리거가 양쪽에 잡혀
  # 중복 재개가 일어날 수 있다.
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: airflow-triggerer
        app.kubernetes.io/name: airflow
        app.kubernetes.io/component: triggerer
        app.kubernetes.io/part-of: data-layer
      annotations:
        checksum/airflow-env: "${config_hash}"
    spec:
      # Service env 자동 주입 차단 — 근거는 CLAUDE.md '쿠버네티스 규약'
      enableServiceLinks: false

      securityContext:
        runAsUser: ${run_as_user}
        runAsGroup: ${fs_group}
        fsGroup: ${fs_group}
      containers:
        - name: triggerer
          image: ${image}
          imagePullPolicy: IfNotPresent
          args: ["triggerer"]
          envFrom:
            - configMapRef:
                name: data-layer-env
            - secretRef:
                name: data-layer-secrets
            - secretRef:
                name: airflow-env
          # dag-processor 와 같은 이유로 exec probe + readiness 생략
          livenessProbe:
            exec:
              command:
                - /bin/bash
                - -c
                - airflow jobs check --job-type TriggererJob --local
            initialDelaySeconds: 60
            periodSeconds: 60
            timeoutSeconds: 30
            failureThreshold: 5
          resources:
            requests:
              cpu: "100m"
              memory: "512Mi"
