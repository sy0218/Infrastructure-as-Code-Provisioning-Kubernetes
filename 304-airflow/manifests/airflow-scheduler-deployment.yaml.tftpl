# ===============================================
# [Airflow scheduler]
#   → LocalExecutor 라 이 파드가 스케줄러이자 태스크 워커다.
#   → 공통 규약(args/securityContext/checksum/envFrom)은 apiserver 템플릿 배너 참조.
# ===============================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: airflow-scheduler
  namespace: ${namespace}
  labels:
    app: airflow-scheduler
    app.kubernetes.io/name: airflow
    app.kubernetes.io/component: scheduler
    app.kubernetes.io/part-of: data-layer
spec:
  replicas: ${replicas}
  selector:
    matchLabels:
      app: airflow-scheduler
  # Recreate — 롤링이면 새 파드와 옛 파드가 잠시 공존하고, 그 사이 옛 파드가 실행 중이던
  # 태스크는 종료 시 실패로 기록된다. 먼저 내리고 나중에 올리면 겹치는 구간이 없다
  # (다운타임 = 새 파드 기동 시간. 밀린 스케줄은 catchup 이 따라잡는다).
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: airflow-scheduler
        app.kubernetes.io/name: airflow
        app.kubernetes.io/component: scheduler
        app.kubernetes.io/part-of: data-layer
      annotations:
        checksum/airflow-env: "${config_hash}"
        # 태스크 파드 원형이 바뀌면 scheduler 를 다시 띄운다 —
        # 파일은 볼륨이라 갱신되지만 프로세스는 기동 시점에 읽은 것을 계속 쓴다.
        checksum/pod-template: "${pod_template_hash}"
    spec:
      # Service env 자동 주입 차단 — 근거는 CLAUDE.md '쿠버네티스 규약'
      enableServiceLinks: false

      # 실행 중이던 태스크가 정리될 시간(기본 30초는 배치 태스크엔 짧다)
      terminationGracePeriodSeconds: 120
      securityContext:
        runAsUser: ${run_as_user}
        runAsGroup: ${fs_group}
        fsGroup: ${fs_group}
      # ── 코드 전달: git-sync ────────────────────────────────────────────────
      # 이미지에는 DAG·커스텀 패키지가 없다(data_layer_airflow/Dockerfile 참조) —
      # 원본은 303-git 의 저장소이고, 이 두 컨테이너가 그것을 emptyDir 로 받아 온다.
      # 파드 securityContext(uid/gid)를 그대로 상속하므로 받아온 파일 소유자가 airflow 와
      # 같아 파싱 캐시(.pyc) 경고가 나지 않는다.
      #
      # ⚠ initContainer 를 빼지 말 것 — 사이드카만 두면 첫 fetch 전에 airflow 가 먼저 떠서
      #   'DAG 0개'로 조용히 기동한다.
      initContainers:
        - name: git-sync-init
          image: ${gitsync_image}
          env:
            - name: GITSYNC_REPO
              value: "${git_repo}"
            - name: GITSYNC_REF
              value: "${git_ref}"
            - name: GITSYNC_ROOT
              value: "/git"
            - name: GITSYNC_LINK
              value: "repo"
            - name: GITSYNC_ONE_TIME
              value: "true"
            # git 이 전역 설정을 쓰려 할 때 쓸 쓰기 가능한 HOME (uid 50000 은 홈이 없다)
            - name: HOME
              value: "/tmp"
          volumeMounts:
            - name: git-repo
              mountPath: /git

      containers:
        - name: scheduler
          image: ${image}
          imagePullPolicy: IfNotPresent
          args: ["scheduler"]
          ports:
            # AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true 가 켜 주는 헬스 서버.
            # Secret 에서 그 값을 끄면 포트가 열리지 않아 아래 probe 가 전부 실패한다.
            - name: health
              containerPort: 8974
          envFrom:
            - configMapRef:
                name: data-layer-env
            - secretRef:
                name: data-layer-secrets
            - secretRef:
                name: airflow-env
          # /health 는 "스케줄러 루프가 최근 하트비트를 남겼는가"를 답한다 —
          # exec probe 와 달리 파이썬을 새로 띄우지 않아 주기를 짧게 가져가도 부담이 없다.
          readinessProbe:
            httpGet:
              path: /health
              port: health
            initialDelaySeconds: 30
            periodSeconds: 10
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /health
              port: health
            initialDelaySeconds: 60
            periodSeconds: 20
            failureThreshold: 6
          # KubernetesExecutor 로 바뀌며 이 파드는 태스크를 직접 돌리지 않는다(파드를 찍기만 한다)
          # → 1Gi 를 잡고 있을 이유가 없고, 그만큼이 태스크 파드 자리가 된다.
          resources:
            requests:
              cpu: "300m"
              memory: "512Mi"
          # DAGS_FOLDER 와 PYTHONPATH 가 이 경로를 가리킨다(Secret airflow-env).
          # ⚠ subPath 로 꽂지 말 것 — git-sync 가 갈아끼우는 심볼릭 링크를 따라가지 못해
          #   동기화가 영원히 반영되지 않는다(에러도 나지 않는다).
          volumeMounts:
            - name: git-repo
              mountPath: /git
            # KubernetesExecutor 가 태스크 파드를 찍을 때 읽는 원형. 파일 하나짜리 ConfigMap 이지만
            # subPath 없이 디렉토리째 마운트한다(subPath 는 ConfigMap 갱신을 따라가지 못한다).
            - name: pod-template
              mountPath: ${pod_template_dir}
              readOnly: true

        # 주기적으로 fetch 해 /git/repo 심볼릭 링크를 통째로 갈아끼운다 →
        # 반쯤 쓰인 파일이 파서에 노출되는 구간이 없다(원자적 교체).
        - name: git-sync
          image: ${gitsync_image}
          imagePullPolicy: IfNotPresent
          env:
            - name: GITSYNC_REPO
              value: "${git_repo}"
            - name: GITSYNC_REF
              value: "${git_ref}"
            - name: GITSYNC_ROOT
              value: "/git"
            - name: GITSYNC_LINK
              value: "repo"
            - name: GITSYNC_PERIOD
              value: "${git_sync_period}"
            - name: HOME
              value: "/tmp"
          volumeMounts:
            - name: git-repo
              mountPath: /git
          resources:
            requests:
              cpu: "10m"
              memory: "32Mi"
      volumes:
        - name: git-repo
          emptyDir: {}
        - name: pod-template
          configMap:
            name: airflow-pod-template
