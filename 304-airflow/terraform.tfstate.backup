  "resources": [
    {
      "mode": "managed",
      "type": "kubernetes_config_map_v1",
      "name": "airflow_pod_template",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "binary_data": null,
            "data": {
              "pod_template.yaml": "# ===============================================\n# [KubernetesExecutor 태스크 파드 원형]\n#   → 태스크 하나당 이 스펙으로 파드가 하나 뜨고, 끝나면 사라진다(상주 워커가 없다).\n#   → 이 파일은 K8s 오브젝트가 아니라 ConfigMap 에 담기는 '문서'다 —\n#     scheduler 가 파일로 읽어(AIRFLOW__KUBERNETES_EXECUTOR__POD_TEMPLATE_FILE) 파드를 찍는다.\n#\n# ⚠ 컨테이너 이름은 반드시 `base` 다. Airflow 가 이 이름으로 컨테이너를 찾아 실행 커맨드를\n#   주입하므로, 다른 이름이면 태스크가 뜨자마자 실패한다. command/args 를 여기 적지 않는 것도\n#   같은 이유다(Airflow 가 채운다).\n#\n# ⚠ git-sync 를 사이드카로 넣지 말 것. 사이드카는 스스로 끝나지 않아 태스크 파드가 영원히\n#   Running 으로 남는다 = 태스크가 끝나지 않는다. 코드는 initContainer 가 한 번만 받아 온다.\n# ===============================================\napiVersion: v1\nkind: Pod\nmetadata:\n  labels:\n    app.kubernetes.io/name: airflow\n    app.kubernetes.io/component: worker\n    app.kubernetes.io/part-of: data-layer\nspec:\n  restartPolicy: Never\n\n  # 코어 4종과 같은 이유로 끈다 — 네임스페이스의 Service env 가 컨테이너 설정을 덮어쓴다\n  enableServiceLinks: false\n\n  securityContext:\n    runAsUser: 50000\n    runAsGroup: 0\n    fsGroup: 0\n\n  initContainers:\n    - name: git-sync-init\n      image: data-layer-harbor:30002/data-layer/git-sync:v0.1.0\n      env:\n        - name: GITSYNC_REPO\n          value: \"git://data-layer-git.data-layer.svc.cluster.local:9418/airflow.git\"\n        - name: GITSYNC_REF\n          value: \"master\"\n        - name: GITSYNC_ROOT\n          value: \"/git\"\n        - name: GITSYNC_LINK\n          value: \"repo\"\n        - name: GITSYNC_ONE_TIME\n          value: \"true\"\n        - name: HOME\n          value: \"/tmp\"\n      volumeMounts:\n        - name: git-repo\n          mountPath: /git\n\n  containers:\n    - name: base\n      image: data-layer-harbor:30002/data-layer/airflow:v0.1.0\n      imagePullPolicy: IfNotPresent\n      # ⚠ 세 개가 다 필요하다 — airflow-env 가 빠지면 메타DB 접속·fernet·JWT 가 없어\n      #   태스크 파드가 기동 즉시 죽는다(코어 4종과 같은 조합).\n      envFrom:\n        - configMapRef:\n            name: data-layer-env\n        - secretRef:\n            name: data-layer-secrets\n        - secretRef:\n            name: airflow-env\n      volumeMounts:\n        - name: git-repo\n          mountPath: /git\n      # 태스크마다 이만큼을 예약한다 — PARALLELISM 과 곱해진 값이 클러스터에 실제로 필요한 양이다.\n      resources:\n        requests:\n          cpu: \"100m\"\n          memory: \"384Mi\"\n\n  volumes:\n    - name: git-repo\n      emptyDir: {}\n"
            },
            "id": "data-layer/airflow-pod-template",
            "immutable": false,
            "metadata": [
              {
                "annotations": null,
                "generate_name": "",
                "generation": 0,
                "labels": {
                  "app.kubernetes.io/name": "airflow",
                  "app.kubernetes.io/part-of": "data-layer"
                },
                "name": "airflow-pod-template",
                "namespace": "data-layer",
                "resource_version": "344218",
                "uid": "46490855-0a59-4574-b5b3-85b578fdd81a"
              }
            ]
          },
