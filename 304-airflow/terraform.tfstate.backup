    {
      "mode": "managed",
      "type": "kubernetes_manifest",
      "name": "airflow_init_job",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "computed_fields": [
              "metadata.annotations",
              "metadata.labels",
              "spec.template.metadata.labels"
            ],
            "field_manager": [],
            "manifest": {
              "value": {
                "apiVersion": "batch/v1",
                "kind": "Job",
                "metadata": {
                  "labels": {
                    "app": "airflow-init",
                    "app.kubernetes.io/component": "init",
                    "app.kubernetes.io/name": "airflow-init",
                    "app.kubernetes.io/part-of": "data-layer"
                  },
                  "name": "airflow-init-v0-1-0",
                  "namespace": "data-layer"
                },
                "spec": {
                  "backoffLimit": 6,
                  "template": {
                    "metadata": {
                      "labels": {
                        "app": "airflow-init",
                        "app.kubernetes.io/component": "init",
                        "app.kubernetes.io/name": "airflow-init",
                        "app.kubernetes.io/part-of": "data-layer"
                      }
                    },
                    "spec": {
                      "containers": [
                        {
                          "args": [
                            "set -euo pipefail\n\n# PG 는 클러스터 밖 로컬 설치라 기동 순서를 Terraform 이 보장하지 못한다.\n# `airflow db check` 는 SQL_ALCHEMY_CONN 으로 실제 접속을 시도하므로\n# \"포트가 열렸다\"가 아니라 \"이 계정으로 이 DB 에 붙는다\"까지 확인해 준다.\ntries=0\nuntil airflow db check \u003e/dev/null 2\u003e\u00261; do\n  tries=$((tries + 1))\n  if [ \"${tries}\" -ge 60 ]; then\n    echo \"PostgreSQL 이 5분 안에 응답하지 않음 — 컨테이너를 재시작해 다시 시도한다\"\n    exit 1\n  fi\n  echo \"  PostgreSQL 미응답(#${tries}) — 5초 후 재시도\"\n  sleep 5\ndone\n\n# 1단계: 메타DB 스키마 생성/업그레이드 (멱등 — 재실행이 안전하다)\necho \"Airflow 메타DB 마이그레이션...\"\nairflow db migrate\n\n# 2단계: 관리자 계정 생성.\n# 이미 있으면 CLI 가 0 이 아닌 코드로 끝나는데 그건 실패가 아니라 '할 일 없음'이다\n# → set -e 아래에서 Job 을 죽이지 않도록 여기서만 실패를 삼킨다.\necho \"관리자 계정 확인/생성: ${AIRFLOW_ADMIN_USERNAME}\"\nairflow users create \\\n  --username \"${AIRFLOW_ADMIN_USERNAME}\" \\\n  --password \"${AIRFLOW_ADMIN_PASSWORD}\" \\\n  --firstname \"${AIRFLOW_ADMIN_FIRSTNAME}\" \\\n  --lastname \"${AIRFLOW_ADMIN_LASTNAME}\" \\\n  --role Admin \\\n  --email \"${AIRFLOW_ADMIN_EMAIL}\" \\\n  || echo \"  이미 존재하는 계정 — 건너뛴다\"\n\necho \"Airflow initialization completed.\"\n"
                          ],
                          "command": [
                            "/bin/bash",
                            "-c"
                          ],
                          "envFrom": [
                            {
                              "configMapRef": {
                                "name": "data-layer-env"
                              }
                            },
                            {
                              "secretRef": {
                                "name": "data-layer-secrets"
                              }
                            },
                            {
                              "secretRef": {
                                "name": "airflow-env"
                              }
                            }
                          ],
                          "image": "data-layer-harbor:30002/data-layer/airflow:v0.1.0",
                          "imagePullPolicy": "IfNotPresent",
                          "name": "airflow-init",
                          "resources": {
                            "requests": {
                              "cpu": "100m",
                              "memory": "512Mi"
                            }
                          }
                        }
                      ],
                      "enableServiceLinks": false,
                      "restartPolicy": "OnFailure",
                      "securityContext": {
                        "fsGroup": 0,
                        "runAsGroup": 0,
                        "runAsUser": 50000
                      }
                    }
                  }
                }
              },
