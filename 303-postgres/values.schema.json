{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "postgres values",
  "description": "원본 303-postgres 의 'default 없는 변수 = tfvars 강제' 규칙의 Helm 판 — 필수 키 누락·오타·형식 오류를 렌더(lint/template/install) 시점에 잡는다. 이 차트가 global 에서 실제로 참조하는 키만 required 로 선언한다(values.common.yaml 을 -f 로 주지 않으면 렌더 전에 실패). global 에는 다른 차트용 키도 함께 들어오므로 additionalProperties 를 막지 않는다.",
  "type": "object",
  "additionalProperties": true,
  "required": ["global", "instances", "imageTag", "storage", "externalIp"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "required": ["namespace", "harborRegistry", "postgres", "secrets"],
      "properties": {
        "namespace": {
          "type": "string",
          "description": "RFC 1123 라벨 — 소문자/숫자/하이픈만. 소유자는 300-data-layer-base",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "harborRegistry": {
          "type": "string",
          "description": "스킴 없는 레지스트리 주소 — 밑줄 금지(Docker 이미지 참조 파서의 domain 규칙)",
          "pattern": "^[a-z0-9]([-.a-z0-9]*[a-z0-9])?(:[0-9]+)?$"
        },
        "postgres": {
          "type": "object",
          "additionalProperties": true,
          "required": ["clusterName", "port", "schema", "databases"],
          "properties": {
            "clusterName": {
              "type": "string",
              "description": "Service/Pod/PVC 이름의 기준. 300 의 접속 호스트 <clusterName>-rw.<ns>.svc.cluster.local 도 이 값에서 파생된다",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 40
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "schema": {
              "type": "string",
              "description": "collector DB 안의 스키마 — postInitApplicationSQL 이 만든다",
              "minLength": 1
            },
            "databases": {
              "type": "object",
              "additionalProperties": false,
              "required": ["collector", "airflow", "icebergCatalog"],
              "properties": {
                "collector": { "type": "string", "minLength": 1 },
                "airflow": { "type": "string", "minLength": 1 },
                "icebergCatalog": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": true,
          "description": "앱 계정 — CNPG 가 role 소유자로 쓴다. Secret 오브젝트 자체는 300-data-layer-base 가 만든다",
          "required": ["postgresUser"],
          "properties": {
            "postgresUser": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "instances": {
      "type": "integer",
      "description": "primary 1 + replica (instances-1). nodeNames 개수를 넘기면 required anti-affinity 때문에 초과분이 Pending 이다(둘의 대소는 JSON Schema 로 검사할 수 없다 — 사람이 맞춘다)",
      "minimum": 1
    },
    "nodeNames": {
      "type": "array",
      "description": "인스턴스를 띄울 노드 이름(kubernetes.io/hostname). 생략하거나 빈 배열이면 nodeAffinity 를 렌더하지 않아 배치가 스케줄러 위임으로 떨어진다 — 저장소 기본 규칙",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 63
      },
      "uniqueItems": true
    },
    "imageTag": {
      "type": "string",
      "description": "operand 이미지 태그 — CNPG 웹훅이 태그에서 PG 버전을 읽으므로 반드시 PG 버전으로 시작해야 한다(16 / 16.15 / 16.15-v0.1.0). v0.1.0·latest 는 거부된다",
      "pattern": "^[0-9]+(\\.[0-9]+)?(-[A-Za-z0-9._-]+)?$"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageClass", "size"],
      "properties": {
        "storageClass": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki)$" }
      }
    },
    "externalIp": {
      "type": "string",
      "description": "MetalLB VIP — 102-ingress 의 postgres_vip 와 같은 값",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$"
    }
  }
}
