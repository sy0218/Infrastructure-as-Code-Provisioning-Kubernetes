# ===============================================
# [Prometheus Service — 내부 질의 + 외부 디버깅 UI]
#   → 내부: Grafana 데이터소스가 부르는 이름(prometheus:${prometheus_port}).
#   → 외부: 타깃 상태/PromQL 을 사람이 직접 보는 경로는 Ingress 가 맡는다
#     (prometheus-ingress.yaml.tftpl) → Service 자체는 ClusterIP 로 충분하다.
#   ⚠ 인증이 없다 — 이 이름에 닿는 사람은 전 메트릭을 조회할 수 있다(내부망 전제).
#     NodePort 시절과 달리 노드 IP 로는 더 이상 열리지 않고 VIP 의 Host 헤더로만 닿는다.
# ===============================================
apiVersion: v1
kind: Service
metadata:
  name: prometheus
  namespace: ${namespace}
  labels:
    app: prometheus
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/part-of: data-layer
spec:
  type: ClusterIP
  selector:
    app: prometheus
  ports:
    - name: http
      port: ${prometheus_port}
      targetPort: http
