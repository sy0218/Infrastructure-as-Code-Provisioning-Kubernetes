apiVersion: v1
kind: ConfigMap
metadata:
  name: alloy-config
  namespace: ${namespace}
  labels:
    app: alloy
    app.kubernetes.io/name: alloy
    app.kubernetes.io/part-of: data-layer
data:
  # 이 키 이름이 곧 마운트되는 파일 이름이다(/etc/alloy/config.alloy) —
  # DaemonSet 의 `alloy run <경로>` 인자와 짝을 맞춰야 한다.
  #
  # ⚠ 여기 아래는 렌더되어 클러스터 ConfigMap 에 그대로 실린다 — 설명은 이 줄 위에 적을 것.
  # ⚠ 여기는 Terraform 템플릿이라 '달러+중괄호'는 보간으로 먹힌다. River 설정에 그 형태가
  #   생기면 달러를 두 번 겹쳐 이스케이프할 것(현재 설정에는 하나도 없다).
  config.alloy: |
    // ============================================================
    // Alloy 수집 설정 (전 노드 공통 — DaemonSet 이라 노드가 늘어도 이 파일 하나뿐)
    // node(서버) + cadvisor(컨테이너) 메트릭을 노출만 하고,
    // 저장/스크랩은 Prometheus 가 pull 로 가져간다(pod role SD, 라벨 app=alloy).
    //
    // 노출 경로(Prometheus 스크랩 경로 = 302-monitoring 의 scrape_config metrics_path):
    //   서버    : /api/v0/component/prometheus.exporter.unix.node/metrics
    //   컨테이너: /api/v0/component/prometheus.exporter.cadvisor.containers/metrics
    // ============================================================

    // ─────────────────────────────────────────────
    // 서버(호스트) 리소스 → node_exporter 역할
    // hostNetwork + /proc·/sys·/ 호스트 마운트로
    // "컨테이너"가 아닌 "서버 실측치"를 수집한다.
    // (Pod 이 자기 netns 안에 있으면 호스트 NIC 통계가 보이지 않는다 — hostNetwork 를 쓰는 유일한 이유)
    // ─────────────────────────────────────────────
    prometheus.exporter.unix "node" {
      procfs_path = "/host/proc"  // DaemonSet hostPath: /proc → /host/proc
      sysfs_path  = "/sys"        // DaemonSet hostPath: /sys  → /sys (cadvisor 도 /sys 를 본다)
      rootfs_path = "/rootfs"     // DaemonSet hostPath: /     → /rootfs
    }

    // ─────────────────────────────────────────────
    // 컨테이너 리소스 → cAdvisor 역할
    // cgroup(+ containerd) 로 컨테이너별 CPU/메모리/네트워크/디스크 수집
    // ─────────────────────────────────────────────
    prometheus.exporter.cadvisor "containers" {
      // ⚠ docker_only = false 로 둔다(기본값이지만 왜인지 남길 가치가 있어 명시).
      //   이 클러스터의 런타임은 containerd 이고 K8s Pod 은 docker 데몬에 속하지 않는다.
      //   true 로 두면 cadvisor 가 docker 소속 cgroup 만 골라내므로 컨테이너 메트릭이
      //   에러 없이 '0건'이 된다(조용한 파손 — 대시보드만 텅 빈다).
      //   대가로 호스트 systemd cgroup(/system.slice/*.service, /init.scope)까지 들어오는데,
      //   그건 Prometheus 쪽 relabel(빈 pod 라벨 drop)에서 걸러낸다.
      docker_only = false

      // 필요한 메트릭 그룹만 수집 (그 외 tasks/process/perf 등은 제외해 시계열 절감)
      //   cpu     → container_cpu_*      (cgroup)
      //   memory  → container_memory_*   (cgroup)
      //   diskIO  → container_fs_*       (블록 읽기/쓰기 I/O, cgroup)
      //   network → container_network_*  (cgroup/proc)
      enabled_metrics = ["cpu", "memory", "diskIO", "network"]

      // 컨테이너 라벨을 통째로 메트릭에 박지 않고, 식별에 필요한 것만 허용
      // (name/id/image 같은 코어 라벨은 항상 유지된다)
      //
      // containerd 는 CRI 가 심는 io.kubernetes.* 라벨로 Pod 정체성을 알려준다 —
      // compose 시절의 com.docker.compose.service 는 K8s 에 존재하지 않아 그대로 두면
      // 컨테이너를 워크로드에 매칭할 수단이 사라진다(어떤 Pod 의 CPU 인지 알 수 없다).
      store_container_labels       = false
      allowlisted_container_labels = [
        "io.kubernetes.pod.name",
        "io.kubernetes.pod.namespace",
        "io.kubernetes.container.name",
      ]
    }
