    {
      "mode": "managed",
      "type": "kubernetes_manifest",
      "name": "prometheus_statefulset",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "computed_fields": null,
            "field_manager": [],
            "manifest": {
              "value": {
                "apiVersion": "apps/v1",
                "kind": "StatefulSet",
                "metadata": {
                  "labels": {
                    "app": "prometheus",
                    "app.kubernetes.io/name": "prometheus",
                    "app.kubernetes.io/part-of": "data-layer"
                  },
                  "name": "prometheus",
                  "namespace": "data-layer"
                },
                "spec": {
                  "replicas": 1,
                  "selector": {
                    "matchLabels": {
                      "app": "prometheus"
                    }
                  },
                  "serviceName": "prometheus",
                  "template": {
                    "metadata": {
                      "annotations": {
                        "checksum/config": "5ec95d1f1b12a1b139cfc4f1714aa378b62429aeba6f1853a0ad470fb6aca78a"
                      },
                      "labels": {
                        "app": "prometheus",
                        "app.kubernetes.io/name": "prometheus",
                        "app.kubernetes.io/part-of": "data-layer"
                      }
                    },
                    "spec": {
                      "containers": [
                        {
                          "args": [
                            "--config.file=/etc/prometheus/prometheus.yml",
                            "--storage.tsdb.path=/prometheus",
                            "--storage.tsdb.retention.time=30d",
                            "--web.enable-lifecycle"
                          ],
                          "image": "data-layer-harbor:30002/data-layer/prometheus:v0.1.0",
                          "imagePullPolicy": "IfNotPresent",
                          "livenessProbe": {
                            "failureThreshold": 6,
                            "httpGet": {
                              "path": "/-/healthy",
                              "port": "http"
                            },
                            "initialDelaySeconds": 60,
                            "periodSeconds": 15
                          },
                          "name": "prometheus",
                          "ports": [
                            {
                              "containerPort": 9090,
                              "name": "http"
                            }
                          ],
                          "readinessProbe": {
                            "failureThreshold": 6,
                            "httpGet": {
                              "path": "/-/ready",
                              "port": "http"
                            },
                            "initialDelaySeconds": 10,
                            "periodSeconds": 10
                          },
                          "resources": {
                            "limits": {
                              "memory": "2Gi"
                            },
                            "requests": {
                              "cpu": "250m",
                              "memory": "1Gi"
                            }
                          },
                          "volumeMounts": [
                            {
                              "mountPath": "/etc/prometheus",
                              "name": "config",
                              "readOnly": true
                            },
                            {
                              "mountPath": "/prometheus",
                              "name": "data"
                            }
                          ]
                        }
                      ],
                      "enableServiceLinks": false,
                      "securityContext": {
                        "fsGroup": 65534
                      },
                      "terminationGracePeriodSeconds": 60,
                      "volumes": [
                        {
                          "configMap": {
                            "name": "prometheus-config"
                          },
                          "name": "config"
                        }
                      ]
                    }
                  },
                  "volumeClaimTemplates": [
                    {
                      "metadata": {
                        "labels": {
                          "app.kubernetes.io/part-of": "data-layer"
                        },
                        "name": "data"
                      },
                      "spec": {
                        "accessModes": [
                          "ReadWriteOnce"
                        ],
                        "resources": {
                          "requests": {
                            "storage": "20Gi"
                          }
                        },
                        "storageClassName": "longhorn"
                      }
                    }
                  ]
                }
              },
              "type": [
                "object",
                {
                  "apiVersion": "string",
                  "kind": "string",
                  "metadata": [
                    "object",
                    {
                      "labels": [
                        "object",
