    {
      "mode": "managed",
      "type": "kubernetes_manifest",
      "name": "prometheus_config",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "computed_fields": null,
            "field_manager": [],
            "manifest": {
              "value": {
                "apiVersion": "v1",
                "data": {
                  "prometheus.yml": "global:\n  scrape_interval: 30s\n\nscrape_configs:\n  # 서버(호스트) 메트릭 — alloy 는 hostNetwork 라 파드 IP = 노드 IP 다.\n  - job_name: alloy-node\n    metrics_path: /api/v0/component/prometheus.exporter.unix.node/metrics\n    kubernetes_sd_configs:\n      - role: pod\n        # 다른 네임스페이스의 동명 라벨 파드가 딸려 들어오지 않도록 범위를 좁힌다\n        namespaces:\n          names: [data-layer]\n    relabel_configs:\n      # 포트 이름까지 keep 하는 이유: role=pod 는 '선언된 컨테이너 포트마다' 타깃을\n      # 만든다 — 포트가 추가되면 같은 파드가 두 번 스크랩되어 시계열이 중복된다.\n      - source_labels: [__meta_kubernetes_pod_label_app, __meta_kubernetes_pod_container_port_name]\n        regex: alloy;http-metrics\n        action: keep\n      # 대시보드 생명줄 — 위 배너 참조\n      - source_labels: [__meta_kubernetes_pod_node_name]\n        target_label: node\n      - source_labels: [__meta_kubernetes_pod_name]\n        target_label: pod\n\n  # 컨테이너 메트릭\n  - job_name: alloy-cadvisor\n    metrics_path: /api/v0/component/prometheus.exporter.cadvisor.containers/metrics\n    kubernetes_sd_configs:\n      - role: pod\n        namespaces:\n          names: [data-layer]\n    relabel_configs:\n      - source_labels: [__meta_kubernetes_pod_label_app, __meta_kubernetes_pod_container_port_name]\n        regex: alloy;http-metrics\n        action: keep\n      - source_labels: [__meta_kubernetes_pod_node_name]\n        target_label: node\n      - source_labels: [__meta_kubernetes_pod_name]\n        target_label: pod\n    metric_relabel_configs:\n      # cgroup 루트(name 라벨이 빈 시리즈)는 컨테이너가 아닌데 container_* 이름을 달고\n      # 나와 랭킹 패널을 오염시킨다. 호스트 지표는 alloy-node 담당.\n      - source_labels: [name]\n        regex: \"\"\n        action: drop\n\n  # Kafka 토픽/offset/컨슈머그룹 lag — exporter 하나가 클러스터 전체를 보므로\n  # 유일하게 endpoints role 을 쓴다(Service 경유 = readiness 통과한 파드만 타깃).\n  - job_name: kafka-exporter\n    kubernetes_sd_configs:\n      - role: endpoints\n        namespaces:\n          names: [data-layer]\n    relabel_configs:\n      # 대상이 몇 개 안 되므로 annotation 자동 발견 대신 Service/포트 이름으로 명시한다\n      - source_labels: [__meta_kubernetes_service_name, __meta_kubernetes_endpoint_port_name]\n        regex: kafka-exporter;metrics\n        action: keep\n      - source_labels: [__meta_kubernetes_pod_node_name]\n        target_label: node\n      - source_labels: [__meta_kubernetes_pod_name]\n        target_label: pod\n\n  # Kafka 브로커 JVM/MBean — 브로커는 클러스터 밖(ADR 0, Ansible 로컬 설치)이라\n  # kubernetes_sd 로 발견할 수 없다 → 노드 IP static 타깃(브로커 안 javaagent :9404).\n  # node/instance 라벨은 타깃에 직접 부여한다(instance=kafka-0/1/2 — 기존 시계열 연속성).\n  - job_name: kafka-jmx\n    static_configs: [{\"labels\":{\"instance\":\"kafka-0\",\"node\":\"ap\"},\"targets\":[\"192.168.56.200:9404\"]},{\"labels\":{\"instance\":\"kafka-1\",\"node\":\"s1\"},\"targets\":[\"192.168.56.201:9404\"]},{\"labels\":{\"instance\":\"kafka-2\",\"node\":\"s2\"},\"targets\":[\"192.168.56.202:9404\"]}]\n"
                },
                "kind": "ConfigMap",
                "metadata": {
                  "labels": {
                    "app": "prometheus",
                    "app.kubernetes.io/name": "prometheus",
                    "app.kubernetes.io/part-of": "data-layer"
                  },
                  "name": "prometheus-config",
                  "namespace": "data-layer"
                }
              },
              "type": [
                "object",
                {
                  "apiVersion": "string",
                  "data": [
                    "object",
                    {
                      "prometheus.yml": "string"
                    }
                  ],
                  "kind": "string",
                  "metadata": [
                    "object",
                    {
                      "labels": [
                        "object",
                        {
                          "app": "string",
                          "app.kubernetes.io/name": "string",
                          "app.kubernetes.io/part-of": "string"
                        }
                      ],
                      "name": "string",
                      "namespace": "string"
                    }
                  ]
                }
              ]
            },
            "object": {
              "value": {
                "apiVersion": "v1",
                "binaryData": null,
                "data": {
                  "prometheus.yml": "global:\n  scrape_interval: 30s\n\nscrape_configs:\n  # 서버(호스트) 메트릭 — alloy 는 hostNetwork 라 파드 IP = 노드 IP 다.\n  - job_name: alloy-node\n    metrics_path: /api/v0/component/prometheus.exporter.unix.node/metrics\n    kubernetes_sd_configs:\n      - role: pod\n        # 다른 네임스페이스의 동명 라벨 파드가 딸려 들어오지 않도록 범위를 좁힌다\n        namespaces:\n          names: [data-layer]\n    relabel_configs:\n      # 포트 이름까지 keep 하는 이유: role=pod 는 '선언된 컨테이너 포트마다' 타깃을\n      # 만든다 — 포트가 추가되면 같은 파드가 두 번 스크랩되어 시계열이 중복된다.\n      - source_labels: [__meta_kubernetes_pod_label_app, __meta_kubernetes_pod_container_port_name]\n        regex: alloy;http-metrics\n        action: keep\n      # 대시보드 생명줄 — 위 배너 참조\n      - source_labels: [__meta_kubernetes_pod_node_name]\n        target_label: node\n      - source_labels: [__meta_kubernetes_pod_name]\n        target_label: pod\n\n  # 컨테이너 메트릭\n  - job_name: alloy-cadvisor\n    metrics_path: /api/v0/component/prometheus.exporter.cadvisor.containers/metrics\n    kubernetes_sd_configs:\n      - role: pod\n        namespaces:\n          names: [data-layer]\n    relabel_configs:\n      - source_labels: [__meta_kubernetes_pod_label_app, __meta_kubernetes_pod_container_port_name]\n        regex: alloy;http-metrics\n        action: keep\n      - source_labels: [__meta_kubernetes_pod_node_name]\n        target_label: node\n      - source_labels: [__meta_kubernetes_pod_name]\n        target_label: pod\n    metric_relabel_configs:\n      # cgroup 루트(name 라벨이 빈 시리즈)는 컨테이너가 아닌데 container_* 이름을 달고\n      # 나와 랭킹 패널을 오염시킨다. 호스트 지표는 alloy-node 담당.\n      - source_labels: [name]\n        regex: \"\"\n        action: drop\n\n  # Kafka 토픽/offset/컨슈머그룹 lag — exporter 하나가 클러스터 전체를 보므로\n  # 유일하게 endpoints role 을 쓴다(Service 경유 = readiness 통과한 파드만 타깃).\n  - job_name: kafka-exporter\n    kubernetes_sd_configs:\n      - role: endpoints\n        namespaces:\n          names: [data-layer]\n    relabel_configs:\n      # 대상이 몇 개 안 되므로 annotation 자동 발견 대신 Service/포트 이름으로 명시한다\n      - source_labels: [__meta_kubernetes_service_name, __meta_kubernetes_endpoint_port_name]\n        regex: kafka-exporter;metrics\n        action: keep\n      - source_labels: [__meta_kubernetes_pod_node_name]\n        target_label: node\n      - source_labels: [__meta_kubernetes_pod_name]\n        target_label: pod\n\n  # Kafka 브로커 JVM/MBean — 브로커는 클러스터 밖(ADR 0, Ansible 로컬 설치)이라\n  # kubernetes_sd 로 발견할 수 없다 → 노드 IP static 타깃(브로커 안 javaagent :9404).\n  # node/instance 라벨은 타깃에 직접 부여한다(instance=kafka-0/1/2 — 기존 시계열 연속성).\n  - job_name: kafka-jmx\n    static_configs: [{\"labels\":{\"instance\":\"kafka-0\",\"node\":\"ap\"},\"targets\":[\"192.168.56.200:9404\"]},{\"labels\":{\"instance\":\"kafka-1\",\"node\":\"s1\"},\"targets\":[\"192.168.56.201:9404\"]},{\"labels\":{\"instance\":\"kafka-2\",\"node\":\"s2\"},\"targets\":[\"192.168.56.202:9404\"]}]\n"
                },
                "immutable": null,
                "kind": "ConfigMap",
