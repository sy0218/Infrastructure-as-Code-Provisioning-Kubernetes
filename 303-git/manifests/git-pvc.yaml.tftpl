# ===============================================
# [bare 저장소 PVC]
#   → Deployment 는 PVC 를 스스로 만들지 못해 별도 오브젝트로 선언한다.
#   → 이 볼륨이 곧 저장소다 — 지우면 커밋 이력이 사라진다.
#     terraform destroy 는 이 PVC 까지 지우므로, 지우기 전에 로컬에 clone 이 있는지 확인할 것.
# ===============================================
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: git-repos
  namespace: ${namespace}
  labels:
    app: data-layer-git
    app.kubernetes.io/name: data-layer-git
    app.kubernetes.io/part-of: data-layer
spec:
  accessModes: ["ReadWriteOnce"]
  # longhorn 인 이유: 노드가 죽으면 파드가 다른 노드로 옮겨가는데 볼륨이 따라와야
  # 저장소가 살아남는다. local-path 면 그 노드와 함께 사라진다.
  storageClassName: ${storage_class}
  resources:
    requests:
      storage: ${storage_size}
