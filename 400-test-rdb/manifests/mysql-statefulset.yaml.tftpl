# ===============================================
# [cdc-mysql — CDC 소스 (binlog)]
#   → Deployment 가 아닌 이유: RWO 볼륨을 두 파드가 동시에 잡으면 안 되는데, STS 는 항상
#     '종료 후 생성'이라 그 창이 없다(prometheus 와 같은 근거).
#   → binlog 옵션을 이미지에 굽지 않고 args 로 준다 — mysql 이미지 entrypoint 는 첫 인자가
#     '-' 로 시작하면 앞에 mysqld 를 붙여 준다(그래서 CMD 를 다시 적지 않는다).
# ===============================================
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: cdc-mysql
  namespace: ${namespace}
  labels:
    app: cdc-mysql
    app.kubernetes.io/name: cdc-mysql
    app.kubernetes.io/component: test-rdb
    app.kubernetes.io/part-of: data-layer
spec:
  serviceName: cdc-mysql
  replicas: 1
  selector:
    matchLabels:
      app: cdc-mysql
  template:
    metadata:
      labels:
        app: cdc-mysql
        app.kubernetes.io/name: cdc-mysql
        app.kubernetes.io/component: test-rdb
        app.kubernetes.io/part-of: data-layer
    spec:
      # Service env 자동 주입 차단 — 근거는 CLAUDE.md '쿠버네티스 규약'
      enableServiceLinks: false
      containers:
        - name: mysql
          image: ${image}
          imagePullPolicy: IfNotPresent
          # 전부 CDC 전제조건이다:
          #   log-bin 없으면 binlog 자체가 없고, ROW/FULL 이 아니면 before 이미지가 비며,
          #   server-id 가 커넥터(database.server.id=5001)와 겹치면 서로 연결을 끊는다.
          #   gtid-mode 는 위치 대신 트랜잭션 ID 로 재개하게 해 파일 로테이션에 강해진다.
          args:
            - --server-id=${server_id}
            - --log-bin=mysql-bin
            - --binlog-format=ROW
            - --binlog-row-image=FULL
            - --gtid-mode=ON
            - --enforce-gtid-consistency=ON
            # ⚠ 커넥터가 이 기간보다 오래 멈추면 재개 위치의 binlog 가 지워져 있다
            #   → 스냅샷부터 다시 뜨거나(설정에 따라) 태스크가 FAILED 로 죽는다.
            - --binlog-expire-logs-seconds=${binlog_expire_seconds}
          ports:
            - name: mysql
              containerPort: ${port}
          # 공용 ConfigMap/Secret 을 envFrom 으로 받지 않는다 — 이 파드가 읽는 이름은
          # MYSQL_* 넷뿐이고, 파이프라인 자격증명을 테스트 픽스처에 넣을 이유가 없다.
          env:
            - name: MYSQL_DATABASE
              value: "${database}"
            - name: MYSQL_USER
              value: "${user}"
            - name: MYSQL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: test-rdb-secrets
                  key: MYSQL_PASSWORD
            - name: MYSQL_ROOT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: test-rdb-secrets
                  key: MYSQL_ROOT_PASSWORD
          volumeMounts:
            - name: data
              mountPath: /var/lib/mysql
            # 첫 기동(빈 볼륨)에만 실행되는 초기화 훅 — 스키마 + 복제 권한
            - name: initdb
              mountPath: /docker-entrypoint-initdb.d
              readOnly: true
          # exec 배열은 셸이 아니라 execve 라 변수 확장이 없다 → sh -c 로 감싼다.
          # ($$ 이스케이프는 Terraform 보간이 아니라 컨테이너 셸 변수라는 뜻이다.)
          readinessProbe:
            exec:
              command:
                - sh
                - -c
                - exec mysqladmin ping --silent -h 127.0.0.1 -uroot -p"$${MYSQL_ROOT_PASSWORD}"
            initialDelaySeconds: 20
            periodSeconds: 10
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 6
          livenessProbe:
            exec:
              command:
                - sh
                - -c
                - exec mysqladmin ping --silent -h 127.0.0.1 -uroot -p"$${MYSQL_ROOT_PASSWORD}"
            initialDelaySeconds: 90
            periodSeconds: 20
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 6
          resources:
            requests:
              cpu: "${cpu_request}"
              memory: "${memory_request}"
      # InnoDB 가 더티 페이지를 내리고 깨끗하게 닫을 시간. 부족하면 다음 기동이 크래시 복구로 시작한다.
      terminationGracePeriodSeconds: 60
      volumes:
        - name: initdb
          configMap:
            name: cdc-mysql-initdb
  volumeClaimTemplates:
    - metadata:
        name: data
        labels:
          app.kubernetes.io/part-of: data-layer
      spec:
        accessModes: ["ReadWriteOnce"]
        # ⚠ STS 의 volumeClaimTemplate PVC 는 terraform destroy 로 지워지지 않는다 —
        #   스키마를 갈아엎으려면 PVC 를 손으로 지워야 한다.
        storageClassName: ${storage_class}
        resources:
          requests:
            storage: ${storage_size}
