#!/usr/bin/env bash
# ===============================================
# [cdc-oracle 초기화 — LogMiner 전제조건 + CDC.CDC_TEST_QM_CONTROL_LOOP]
#
# 이미지의 /container-entrypoint-initdb.d 훅으로 실행된다 → 볼륨이 빈 첫 기동에만 돈다.
# ⚠ 여기서 실패하면 DB 는 이미 만들어진 뒤라 두 번째 기동에는 이 훅이 아예 돌지 않는다.
#   반쯤 설정된 DB 가 "정상 기동"처럼 보이므로, 실패했으면 PVC 를 지우고 다시 만들 것.
#
# .sql 이 아니라 .sh 인 이유: c##dbzuser 의 비밀번호를 Secret 에서 env 로 받아야 하는데
# sqlplus 는 스크립트 파일에 환경변수를 넘길 방법이 없다(셸이 heredoc 으로 끼워 넣어야 한다).
# ConfigMap 을 0755 로 마운트해 이미지가 source 가 아니라 실행으로 돌린다(entrypoint 의 -x 분기).
#
# 넷 중 이미지가 이미 해 주는 것 (여기서 다시 하지 않는다):
#   ENABLE_ARCHIVELOG=true    ARCHIVELOG 모드 + FRA(db_recovery_file_dest)
#   ENABLE_FORCE_LOGGING=true FORCE LOGGING
#   APP_USER=${app_user}      PDB 안의 업무 스키마 겸 계정
#
# 커넥터 계약 — data_layer_debezium/connect_json/cdc-oracle-qm-control-loop.json
#   database.dbname     ${cdb_name}        database.pdb.name  ${pdb_name}
#   database.user       ${dbz_user}
#   table.include.list  CDC.CDC_TEST_QM_CONTROL_LOOP   (Oracle 은 식별자를 대문자로 저장한다)
# ===============================================
set -euo pipefail

: "$${DBZ_PASSWORD:?Secret test-rdb-secrets 의 DBZ_PASSWORD 가 주입되지 않았다}"

# heredoc 에 따옴표를 두지 않는다(셸이 $${DBZ_PASSWORD} 를 끼워 넣어야 하므로).
# 그 대신 Oracle 식별자의 달러(CDB\$ROOT · V_\$LOG 등)는 전부 백슬래시로 막는다 —
# 빠뜨리면 셸이 빈 문자열로 치환해 "invalid identifier" 가 된다.
sqlplus -s / as sysdba <<SQL
WHENEVER SQLERROR EXIT SQL.SQLCODE
SET ECHO ON

-- ── 메모리 ────────────────────────────────────────────────────────────────
-- Free 에디션은 SGA+PGA 합계가 2GB 로 묶여 있다. DBCA 는 이 값을 노드 메모리에서 추정하는데,
-- 그러면 같은 코드가 노드마다 다른 크기로 뜬다 → 명시적으로 못 박는다.
-- ⚠ SCOPE=SPFILE 이라 이번 기동이 아니라 다음 기동부터 적용된다.
ALTER SYSTEM SET sga_target = ${sga_target} SCOPE = SPFILE;
ALTER SYSTEM SET pga_aggregate_target = ${pga_aggregate_target} SCOPE = SPFILE;

-- ── LogMiner 작업 테이블스페이스 ──────────────────────────────────────────
-- CDB 루트와 PDB 양쪽에 필요하다. 공통유저는 컨테이너를 오가며 두 곳 모두에서
-- 기본 테이블스페이스를 해석하므로 한쪽만 만들면 CREATE USER 가 거부된다.
CREATE TABLESPACE LOGMINER_TBS
  DATAFILE '${oradata_path}/${cdb_name}/logminer_tbs.dbf'
  SIZE 25M REUSE AUTOEXTEND ON MAXSIZE UNLIMITED;

ALTER SESSION SET CONTAINER = ${pdb_name};
CREATE TABLESPACE LOGMINER_TBS
  DATAFILE '${oradata_path}/${cdb_name}/${pdb_name}/logminer_tbs.dbf'
  SIZE 25M REUSE AUTOEXTEND ON MAXSIZE UNLIMITED;
ALTER SESSION SET CONTAINER = CDB\$ROOT;

-- ── LogMiner 계정 ─────────────────────────────────────────────────────────
-- c## 접두의 '공통유저'여야 한다: 커넥터는 CDB 루트로 붙은 뒤 SET CONTAINER 로 PDB 로
-- 넘어가는데, 로컬 유저는 그 전환을 할 수 없다.
-- ⚠ 비밀번호에 큰따옴표가 들어가면 이 문장이 깨진다(랩 값 기준으로만 검증됨).
CREATE USER ${dbz_user} IDENTIFIED BY "$${DBZ_PASSWORD}"
  DEFAULT TABLESPACE LOGMINER_TBS
  QUOTA UNLIMITED ON LOGMINER_TBS
  CONTAINER = ALL;

-- CONTAINER=ALL 이 빠지면 루트에서만 유효해 PDB 전환 직후 권한 부족으로 죽는다.
GRANT CREATE SESSION            TO ${dbz_user} CONTAINER = ALL;
GRANT SET CONTAINER             TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ANY TABLE          TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ANY TRANSACTION    TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ANY DICTIONARY     TO ${dbz_user} CONTAINER = ALL;
GRANT FLASHBACK ANY TABLE       TO ${dbz_user} CONTAINER = ALL;
GRANT LOCK ANY TABLE            TO ${dbz_user} CONTAINER = ALL;
-- 아래 둘은 커넥터가 자기 작업 테이블(플러시 테이블)을 만드는 데 쓴다
GRANT CREATE TABLE              TO ${dbz_user} CONTAINER = ALL;
GRANT CREATE SEQUENCE           TO ${dbz_user} CONTAINER = ALL;
-- redo 를 실제로 마이닝하는 권한. 이것만 빠져도 태스크가 기동 직후 죽는다.
GRANT LOGMINING                 TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT_CATALOG_ROLE       TO ${dbz_user} CONTAINER = ALL;
GRANT EXECUTE_CATALOG_ROLE      TO ${dbz_user} CONTAINER = ALL;

-- 동적 성능 뷰 개별 부여. SELECT ANY DICTIONARY 로 대부분 덮이지만 Debezium 공식 절차가
-- 명시하는 목록이라 그대로 둔다 — 버전에 따라 ANY DICTIONARY 가 V_\$ 뷰를 덮지 않는다.
GRANT SELECT ON V_\$DATABASE            TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ON V_\$INSTANCE            TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ON V_\$LOG                 TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ON V_\$LOGFILE             TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ON V_\$ARCHIVED_LOG        TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ON V_\$ARCHIVE_DEST_STATUS TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ON V_\$LOGMNR_CONTENTS     TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ON V_\$LOGMNR_LOGS         TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ON V_\$TRANSACTION         TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ON V_\$SESSION             TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ON V_\$MYSTAT              TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ON V_\$STATNAME            TO ${dbz_user} CONTAINER = ALL;
GRANT SELECT ON V_\$PARAMETER           TO ${dbz_user} CONTAINER = ALL;

-- ── 보충로깅 ──────────────────────────────────────────────────────────────
-- DB 최소 보충로깅. 없으면 redo 에 행 식별자가 실리지 않아 LogMiner 가 변경을 재구성하지 못한다.
-- (CDB 루트에서만 걸 수 있다 — PDB 세션에서는 무시된다.)
ALTER DATABASE ADD SUPPLEMENTAL LOG DATA;

-- ── 업무 테이블 ───────────────────────────────────────────────────────────
ALTER SESSION SET CONTAINER = ${pdb_name};

-- 컬럼 목록은 배치 경로(CSV, /jsy/data_test/qm_control_loop/*/control_loop_defs.csv)와 1:1 이다.
-- CREATED_AT/UPDATED_AT 만 CSV 에 없고 DB 가 채운다 — 커넥터의 drop SMT 가 둘을 뺀다.
-- ⚠ 컬럼을 추가하면 커넥터 JSON 의 lower SMT(대문자→소문자 renames)에도 반드시 추가할 것.
--   빠뜨리면 그 필드만 대문자로 흘러 mapper 가 못 찾는다.
CREATE TABLE ${app_user}.cdc_test_qm_control_loop (
  control_loop_id               VARCHAR2(64)   NOT NULL,
  control_loop_name             VARCHAR2(200)  NOT NULL,
  step_code                     VARCHAR2(64)   NOT NULL,
  cv_tag                        VARCHAR2(128)  NOT NULL,
  cv_target_tag                 VARCHAR2(128),
  cv_measurement_equipment_id   VARCHAR2(64),
  cv_target_source_equipment_id VARCHAR2(64),
  mv_actuator_equipment_ids     VARCHAR2(1000),
  related_event_type_codes      VARCHAR2(1000),
  description                   VARCHAR2(4000),
  created_at                    TIMESTAMP(3)   DEFAULT SYSTIMESTAMP NOT NULL,
  updated_at                    TIMESTAMP(3)   DEFAULT SYSTIMESTAMP NOT NULL,
  CONSTRAINT pk_cdc_test_qm_control_loop PRIMARY KEY (control_loop_id)
);

CREATE INDEX ${app_user}.idx_cdc_ctrl_loop_step
  ON ${app_user}.cdc_test_qm_control_loop (step_code);

-- 테이블 단위 ALL COLUMNS 보충로깅. 없으면 UPDATE 의 before/after 에 바뀐 컬럼만 실려
-- 커넥터의 cdc_before 헤더가 사실상 비고, unwrap 뒤 행이 부분 행이 된다.
ALTER TABLE ${app_user}.cdc_test_qm_control_loop
  ADD SUPPLEMENTAL LOG DATA (ALL) COLUMNS;

EXIT
SQL

echo "CONTAINER: cdc-oracle 초기화 완료 (${dbz_user} · LOGMINER_TBS · 보충로깅 · CDC.CDC_TEST_QM_CONTROL_LOOP)"
