# ===============================================
# [cdc-mysql Service]
#   → 이 이름이 계약이다 — 커넥터 JSON 의 database.hostname 과 Airflow 커넥션 cdc_mysql
#     이 이 FQDN 을 가리킨다. docker 시절의 192.168.56.201:13306 을 대체한다.
#   → ClusterIP 뿐이다. 사람이 붙을 때는 옛 포트를 그대로 재현한다:
#       kubectl -n ${namespace} port-forward svc/cdc-mysql 13306:${port}
# ===============================================
apiVersion: v1
kind: Service
metadata:
  name: cdc-mysql
  namespace: ${namespace}
  labels:
    app: cdc-mysql
    app.kubernetes.io/name: cdc-mysql
    app.kubernetes.io/component: test-rdb
    app.kubernetes.io/part-of: data-layer
spec:
  type: ClusterIP
  selector:
    app: cdc-mysql
  ports:
    - name: mysql
      port: ${port}
      targetPort: mysql
