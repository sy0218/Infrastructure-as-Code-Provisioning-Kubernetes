-- ===============================================
-- [cdc-mssql 초기화 — ${database}.dbo.cdc_test_qm_qc_result + 네이티브 CDC]
--
-- 넷 중 유일하게 이미지에 초기화 훅이 없어 별도 Job(mssql-init-job)이 이 파일을 돌린다.
-- 그래서 이 스크립트만은 '여러 번 돌아도 되는' 형태여야 한다 — 전부 IF NOT EXISTS 로 감싼 이유.
--
-- 커넥터 계약 — data_layer_debezium/connect_json/cdc-mssql-qm-qc-results.json
--   database.names       ${database}
--   table.include.list   dbo.cdc_test_qm_qc_result
--   database.user        sa
-- ===============================================

IF DB_ID(N'${database}') IS NULL
BEGIN
    -- 복구 모델은 model DB 를 따라 FULL 이 된다. SIMPLE 로 바꾸지 말 것 —
    -- 네이티브 CDC 는 로그 스캔이라 복구 모델이 SIMPLE 이어도 동작은 하지만,
    -- 로그가 조기 재사용되면서 캡처 잡이 변경을 놓칠 수 있다.
    EXEC (N'CREATE DATABASE [${database}]');
END
GO

USE [${database}];
GO

-- 컬럼 목록은 배치 경로(CSV, /jsy/data_test/qm_qc_result/*/qc_results.csv)의 헤더와 1:1 이다.
-- created_at/updated_at 만 CSV 에 없고 DB 가 채운다 — 커넥터의 drop SMT 가 둘을 뺀다.
-- ⚠ qc_ts 는 DATETIME2 라 Debezium 이 epoch 정수로 내보낸다. 커넥터의 ts1(TimestampConverter)이
--   그것을 문자열로 되돌린다 — 타입을 바꾸면 그 SMT 도 같이 봐야 한다.
IF OBJECT_ID(N'dbo.cdc_test_qm_qc_result', N'U') IS NULL
BEGIN
    CREATE TABLE dbo.cdc_test_qm_qc_result (
        batch_id     NVARCHAR(64)   NOT NULL,
        qc_ts        DATETIME2(3)   NOT NULL,
        unit_id      NVARCHAR(64)   NULL,
        qc_target    FLOAT          NULL,
        qc_score     FLOAT          NULL,
        qc_deviation FLOAT          NULL,
        qc_pass      BIT            NULL,
        defect_list  NVARCHAR(1000) NULL,
        created_at   DATETIME2(3)   NOT NULL CONSTRAINT df_cdc_qc_created DEFAULT SYSUTCDATETIME(),
        updated_at   DATETIME2(3)   NOT NULL CONSTRAINT df_cdc_qc_updated DEFAULT SYSUTCDATETIME(),
        CONSTRAINT pk_cdc_test_qm_qc_result PRIMARY KEY CLUSTERED (batch_id)
    );

    CREATE NONCLUSTERED INDEX idx_cdc_qc_ts   ON dbo.cdc_test_qm_qc_result (qc_ts);
    CREATE NONCLUSTERED INDEX idx_cdc_qc_pass ON dbo.cdc_test_qm_qc_result (qc_pass);
END
GO

-- DB 단위 CDC. 이 호출이 cdc 스키마와 cdc_capture/cdc_cleanup SQL Agent 잡 두 개를 만든다.
-- ⚠ MSSQL_AGENT_ENABLED 가 꺼져 있으면 잡이 돌지 않아 변경이 아예 캡처되지 않는다 —
--   커넥터는 정상(RUNNING)인데 토픽만 비는, 원인 찾기 나쁜 고장이 된다.
IF NOT EXISTS (SELECT 1 FROM sys.databases WHERE name = N'${database}' AND is_cdc_enabled = 1)
BEGIN
    EXEC sys.sp_cdc_enable_db;
END
GO

-- 테이블 단위 CDC. @role_name = NULL 이면 별도 게이팅 롤을 만들지 않는다(랩 전제 — sa 로 붙는다).
-- @supports_net_changes = 1 은 PK 가 있어야 한다 → 위 CREATE TABLE 의 클러스터드 PK 가 전제다.
IF NOT EXISTS (SELECT 1 FROM cdc.change_tables WHERE capture_instance = N'dbo_cdc_test_qm_qc_result')
BEGIN
    EXEC sys.sp_cdc_enable_table
        @source_schema        = N'dbo',
        @source_name          = N'cdc_test_qm_qc_result',
        @role_name            = NULL,
        @supports_net_changes = 1;
END
GO
