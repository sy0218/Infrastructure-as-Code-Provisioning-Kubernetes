# ===============================================
# [cdc-mssql 초기화 Job — 스키마 + 네이티브 CDC 활성화]
#   → 넷 중 이것만 Job 인 이유: postgres·mysql·oracle 이미지는 첫 기동에 초기화 스크립트를
#     돌려 주는 훅이 있는데 SQL Server 이미지에는 그런 자리가 없다.
#   → initContainer 로 못 하는 이유도 같다 — 서버가 떠서 접속을 받은 뒤에야 실행할 수 있는데,
#     initContainer 는 그 서버(같은 파드의 메인 컨테이너)보다 먼저 끝나야 한다.
#   → 이름에 SQL 해시가 들어간다: Job spec 은 불변이라 같은 이름으로 다시 apply 하면
#     "field is immutable" 로 막힌다. 스크립트를 고치면 해시가 바뀌어 새 Job 이 한 번 더 돈다
#     (스크립트가 IF NOT EXISTS 로 전부 감싸여 있어 재실행이 안전하다).
#   ⚠ 옛 이름의 Job 을 Terraform 이 지울 때 완료된 파드는 고아로 남는다(batch/v1 기본 GC 가 Orphan).
#     정리: kubectl -n ${namespace} delete pod -l app=cdc-mssql-init --field-selector=status.phase==Succeeded
# ===============================================
apiVersion: batch/v1
kind: Job
metadata:
  name: ${job_name}
  namespace: ${namespace}
  labels:
    app: cdc-mssql-init
    app.kubernetes.io/name: cdc-mssql-init
    app.kubernetes.io/component: test-rdb
    app.kubernetes.io/part-of: data-layer
spec:
  # SQL Server 기동을 기다리다 실패해도 다시 붙어 본다(파드 내부 대기 루프 5분 × 최대 7회)
  backoffLimit: 6
  template:
    metadata:
      labels:
        app: cdc-mssql-init
        app.kubernetes.io/name: cdc-mssql-init
        app.kubernetes.io/component: test-rdb
        app.kubernetes.io/part-of: data-layer
    spec:
      # Service env 자동 주입 차단 — 근거는 CLAUDE.md '쿠버네티스 규약'
      enableServiceLinks: false

      # OnFailure — 파드를 새로 만들지 않고 컨테이너만 다시 돌린다(파드 잔해가 안 쌓인다)
      restartPolicy: OnFailure
      containers:
        - name: mssql-init
          # 서버와 같은 이미지를 쓴다 — sqlcmd 가 그 안에 있어서 도구 이미지를 따로 두지 않는다
          image: ${image}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/bash
            - -c
          args:
            - |
              set -euo pipefail

              # 문자열 변수가 아니라 함수인 이유: 문자열이면 비밀번호가 단어 분리에 노출돼
              # 공백이 섞이는 순간 인자가 쪼개진다. 함수 안에서는 따옴표가 유지된다.
              # sqlcmd 18 은 기본이 TLS 검증이라 자체 서명 인증서만 있는 이 서버에는 -C 가 필수다.
              sqlcmd_run() {
                /opt/mssql-tools18/bin/sqlcmd -C -S "${mssql_host},${mssql_port}" \
                  -U sa -P "$${MSSQL_SA_PASSWORD}" "$@"
              }

              # STS 기동 순서를 Terraform 이 보장하지 못한다(다른 리소스라 depends_on 은 '생성'만 보장).
              # 포트가 열렸는지가 아니라 "sa 로 붙어 쿼리가 돈다"까지 확인한다.
              tries=0
              until sqlcmd_run -Q "SELECT 1" -b -l 5 >/dev/null 2>&1; do
                tries=$((tries + 1))
                if [ "$${tries}" -ge 60 ]; then
                  echo "SQL Server 가 5분 안에 응답하지 않음 — 컨테이너를 재시작해 다시 시도한다"
                  exit 1
                fi
                echo "  SQL Server 미응답(#$${tries}) — 5초 후 재시도"
                sleep 5
              done

              # -b: 오류가 나면 0 이 아닌 코드로 끝난다(없으면 실패해도 Job 이 성공으로 보인다).
              echo "스키마 + CDC 활성화 적용..."
              sqlcmd_run -b -i /init/01_cdc_test_qm_qc_result.sql

              # 사람이 로그만 보고 성공을 판단할 수 있게 결과를 한 줄 남긴다
              sqlcmd_run -b -h -1 -W -Q \
                "SELECT CONCAT('is_cdc_enabled=', CAST(is_cdc_enabled AS varchar)) FROM sys.databases WHERE name=N'${database}'"
              echo "cdc-mssql 초기화 완료."
          env:
            - name: MSSQL_SA_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: test-rdb-secrets
                  key: MSSQL_SA_PASSWORD
          volumeMounts:
            - name: init-sql
              mountPath: /init
              readOnly: true
          resources:
            requests:
              cpu: "100m"
              memory: "128Mi"
      volumes:
        - name: init-sql
          configMap:
            name: cdc-mssql-initdb
