# ===============================================
# [cdc-postgres — CDC 소스 (논리복제 / pgoutput)]
#   → Deployment 가 아닌 이유: RWO 볼륨을 두 파드가 동시에 잡으면 안 되는데, STS 는 항상
#     '종료 후 생성'이라 그 창이 없다(prometheus 와 같은 근거).
#   → 서버 파라미터를 이미지에 굽지 않고 args 로 준다 — postgres 이미지 entrypoint 는
#     첫 인자가 '-' 로 시작하면 앞에 postgres 를 붙여 준다(그래서 CMD 를 다시 적지 않는다).
# ===============================================
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: cdc-postgres
  namespace: ${namespace}
  labels:
    app: cdc-postgres
    app.kubernetes.io/name: cdc-postgres
    app.kubernetes.io/component: test-rdb
    app.kubernetes.io/part-of: data-layer
spec:
  serviceName: cdc-postgres
  replicas: 1
  selector:
    matchLabels:
      app: cdc-postgres
  template:
    metadata:
      labels:
        app: cdc-postgres
        app.kubernetes.io/name: cdc-postgres
        app.kubernetes.io/component: test-rdb
        app.kubernetes.io/part-of: data-layer
    spec:
      # Service env 자동 주입 차단 — 근거는 CLAUDE.md '쿠버네티스 규약'
      enableServiceLinks: false
      containers:
        - name: postgres
          image: ${image}
          imagePullPolicy: IfNotPresent
          # 넷 다 논리복제/CDC 전제조건이다. wal_level 이 logical 이 아니면 슬롯 생성부터 실패하고,
          # wal_sender_timeout=0 이 없으면 저활동 구간에서 느린 랩이 복제 연결을 스스로 끊는다.
          args:
            - -c
            - wal_level=logical
            - -c
            - max_wal_senders=10
            - -c
            - max_replication_slots=10
            - -c
            - wal_sender_timeout=0
          ports:
            - name: postgres
              containerPort: ${port}
          # 공용 ConfigMap/Secret 을 envFrom 으로 받지 않는다 — 이 파드가 읽는 이름은
          # POSTGRES_* 셋뿐이고, 파이프라인 자격증명을 테스트 픽스처에 넣을 이유가 없다.
          env:
            - name: POSTGRES_DB
              value: "${database}"
            - name: POSTGRES_USER
              value: "${user}"
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: test-rdb-secrets
                  key: POSTGRES_PASSWORD
            # ⚠ 볼륨 루트를 그대로 PGDATA 로 쓰지 않는다. 블록 스토리지(longhorn)로 바꾸면
            #   ext4 의 lost+found 때문에 initdb 가 "directory not empty" 로 거부한다.
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
            # 첫 기동(빈 볼륨)에만 실행되는 초기화 훅 — 스키마·publication·REPLICA IDENTITY
            - name: initdb
              mountPath: /docker-entrypoint-initdb.d
              readOnly: true
          # HTTP 가 아니라 프로토콜 레벨 확인이 필요하다 — pg_isready 는 포트가 열렸는지가 아니라
          # "이 DB 가 접속을 받는다"까지 본다(initdb 가 도는 동안은 실패한다).
          readinessProbe:
            exec:
              command: ["pg_isready", "-U", "${user}", "-d", "${database}", "-h", "127.0.0.1"]
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 6
          livenessProbe:
            exec:
              command: ["pg_isready", "-U", "${user}", "-d", "${database}", "-h", "127.0.0.1"]
            initialDelaySeconds: 60
            periodSeconds: 20
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 6
          resources:
            requests:
              cpu: "${cpu_request}"
              memory: "${memory_request}"
      # 체크포인트를 끝낼 시간을 준다. 부족하면 다음 기동이 crash recovery 로 시작한다.
      terminationGracePeriodSeconds: 60
      volumes:
        - name: initdb
          configMap:
            name: cdc-postgres-initdb
  volumeClaimTemplates:
    - metadata:
        name: data
        labels:
          app.kubernetes.io/part-of: data-layer
      spec:
        accessModes: ["ReadWriteOnce"]
        # ⚠ STS 의 volumeClaimTemplate PVC 는 terraform destroy 로 지워지지 않는다(K8s 가
        #   STS 삭제 시 PVC 를 남긴다) — 스키마를 갈아엎으려면 PVC 를 손으로 지워야 한다.
        storageClassName: ${storage_class}
        resources:
          requests:
            storage: ${storage_size}
