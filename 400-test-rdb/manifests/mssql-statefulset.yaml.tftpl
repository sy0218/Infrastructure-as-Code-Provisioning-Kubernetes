# ===============================================
# [cdc-mssql — CDC 소스 (네이티브 CDC)]
#   → Deployment 가 아닌 이유: RWO 볼륨을 두 파드가 동시에 잡으면 안 되는데, STS 는 항상
#     '종료 후 생성'이라 그 창이 없다(prometheus 와 같은 근거).
#   → args 를 주지 않는다 — 이미지의 CMD(/opt/mssql/bin/sqlservr)가 그대로 필요하고,
#     서버 설정은 인자가 아니라 MSSQL_* 환경변수로 받는 구조다.
#   → 스키마·CDC 활성화는 여기 없다. 이미지에 초기화 훅이 없어 별도 Job 이 맡는다(mssql.tf).
# ===============================================
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: cdc-mssql
  namespace: ${namespace}
  labels:
    app: cdc-mssql
    app.kubernetes.io/name: cdc-mssql
    app.kubernetes.io/component: test-rdb
    app.kubernetes.io/part-of: data-layer
spec:
  serviceName: cdc-mssql
  replicas: 1
  selector:
    matchLabels:
      app: cdc-mssql
  template:
    metadata:
      labels:
        app: cdc-mssql
        app.kubernetes.io/name: cdc-mssql
        app.kubernetes.io/component: test-rdb
        app.kubernetes.io/part-of: data-layer
    spec:
      # Service env 자동 주입 차단 — 근거는 CLAUDE.md '쿠버네티스 규약'
      enableServiceLinks: false
      securityContext:
        # 이미지는 mssql(10001)로 돈다. local-path 볼륨은 0777 이라 없어도 뜨지만,
        # storage_class 를 longhorn 으로 바꾸면 새 볼륨이 root:root 0755 로 와서 첫 기동에 죽는다.
        fsGroup: 10001
        fsGroupChangePolicy: OnRootMismatch
      containers:
        - name: mssql
          image: ${image}
          imagePullPolicy: IfNotPresent
          ports:
            - name: mssql
              containerPort: ${port}
          # 공용 ConfigMap/Secret 을 envFrom 으로 받지 않는다 — 이 파드가 읽는 이름은
          # MSSQL_*/ACCEPT_EULA 뿐이고, 파이프라인 자격증명을 테스트 픽스처에 넣을 이유가 없다.
          env:
            - name: ACCEPT_EULA
              value: "Y"
            - name: MSSQL_PID
              value: "${edition}"
            # ⚠ CDC 의 실행 주체다. 이 값이 꺼지면 cdc_capture 잡이 돌지 않아 변경이
            #   아예 캡처되지 않는다(커넥터는 RUNNING 인데 토픽만 빈다).
            - name: MSSQL_AGENT_ENABLED
              value: "true"
            # docker 원본에는 없던 항목이다. 상한이 없으면 SQL Server 가 노드 메모리 전체를
            # 버퍼풀 후보로 잡아 2.8Gi 노드에서 다른 파드를 밀어낸다.
            - name: MSSQL_MEMORY_LIMIT_MB
              value: "${memory_limit_mb}"
            - name: MSSQL_SA_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: test-rdb-secrets
                  key: MSSQL_SA_PASSWORD
          volumeMounts:
            - name: data
              mountPath: /var/opt/mssql
          # sqlcmd 18 은 기본이 TLS 검증이라 자체 서명 인증서만 있는 이 서버에는 -C(신뢰)가 필수다.
          # 커넥터 쪽에서 database.encrypt=false 를 주는 것과 같은 이유의 조치다.
          # exec 배열은 셸이 아니라 execve 라 변수 확장이 없다 → sh -c 로 감싼다.
          readinessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - exec /opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P "$${MSSQL_SA_PASSWORD}" -Q "SELECT 1" -b -l 5
            initialDelaySeconds: 20
            periodSeconds: 10
            timeoutSeconds: 10
            successThreshold: 1
            failureThreshold: 12
          livenessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - exec /opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P "$${MSSQL_SA_PASSWORD}" -Q "SELECT 1" -b -l 5
            initialDelaySeconds: 120
            periodSeconds: 30
            timeoutSeconds: 10
            successThreshold: 1
            failureThreshold: 6
          resources:
            requests:
              cpu: "${cpu_request}"
              memory: "${memory_request}"
      # 체크포인트 후 깨끗하게 닫을 시간. 부족하면 다음 기동이 복구로 시작한다.
      terminationGracePeriodSeconds: 60
  volumeClaimTemplates:
    - metadata:
        name: data
        labels:
          app.kubernetes.io/part-of: data-layer
      spec:
        accessModes: ["ReadWriteOnce"]
        # ⚠ STS 의 volumeClaimTemplate PVC 는 terraform destroy 로 지워지지 않는다 —
        #   스키마를 갈아엎으려면 PVC 를 손으로 지워야 한다.
        storageClassName: ${storage_class}
        resources:
          requests:
            storage: ${storage_size}
