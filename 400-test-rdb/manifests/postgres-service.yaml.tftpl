# ===============================================
# [cdc-postgres Service]
#   → 이 이름이 계약이다 — 커넥터 JSON 의 database.hostname 과 Airflow 커넥션 cdc_postgres
#     가 이 FQDN 을 가리킨다. docker 시절의 192.168.56.201:15432 를 대체한다.
#   → ClusterIP 뿐이다: 소비자(kafka-connect · airflow)가 전부 클러스터 안에 있고,
#     사람이 붙을 때는 kubectl port-forward 로 옛 포트를 그대로 재현한다.
#       kubectl -n ${namespace} port-forward svc/cdc-postgres 15432:${port}
# ===============================================
apiVersion: v1
kind: Service
metadata:
  name: cdc-postgres
  namespace: ${namespace}
  labels:
    app: cdc-postgres
    app.kubernetes.io/name: cdc-postgres
    app.kubernetes.io/component: test-rdb
    app.kubernetes.io/part-of: data-layer
spec:
  type: ClusterIP
  selector:
    app: cdc-postgres
  ports:
    - name: postgres
      port: ${port}
      targetPort: postgres
