# ===============================================
# [Harbor — 브라우저 + docker/containerd 진입점]
#   → 차트의 expose.type 을 clusterIP 로 두고 Ingress 는 이 파일이 소유한다(다른 스택과 같은 형태).
#     차트가 만드는 Ingress 를 쓰면 어노테이션이 차트 values 안에 숨어 이 저장소의
#     "노출은 매니페스트가 소유한다" 규약과 어긋난다.
#   ⚠ 이 host 는 접속 주소일 뿐 아니라 '이미지 이름의 일부'다
#     (data-layer-harbor/data-layer/api:v0.1.0). 바꾸면 전 스택 harbor_registry 와
#     노드 3대의 containerd certs.d 디렉토리명까지 함께 가야 한다.
# ===============================================
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: harbor
  namespace: ${namespace}
  labels:
    app: harbor
    app.kubernetes.io/name: harbor
    app.kubernetes.io/part-of: data-layer
  annotations:
    # ⚠ 레지스트리에 이 셋이 없으면 UI 는 멀쩡한데 docker push 만 죽는다.
    #   0 = 무제한. 이미지 레이어는 수백 MB 라 기본값 1m 으로는 첫 레이어에서 413 이다.
    nginx.ingress.kubernetes.io/proxy-body-size: "0"
    #   버퍼링을 끄면 nginx 가 레이어를 디스크에 모았다 넘기지 않고 그대로 흘려보낸다.
    #   켜 두면 큰 레이어에서 인그레스 파드의 임시 디스크가 먼저 찬다.
    nginx.ingress.kubernetes.io/proxy-request-buffering: "off"
    #   느린 랩 네트워크에서 큰 레이어 하나가 60초(기본값)를 넘긴다.
    nginx.ingress.kubernetes.io/proxy-read-timeout: "${proxy_timeout}"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "${proxy_timeout}"
    # TLS 없는 HTTP 레지스트리다 — HTTPS 로 되돌리면 containerd 가 hosts.toml 을 무시하고
    # "server gave HTTP response to HTTPS client" 로 실패한다.
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
spec:
  ingressClassName: nginx
  rules:
    - host: ${host}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                # 차트의 expose.clusterIP.name — 포트 80 → 내부 nginx 의 8080
                name: harbor
                port:
                  number: ${harbor_port}
