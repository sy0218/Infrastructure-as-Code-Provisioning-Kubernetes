# ===============================================
# [IPAddressPool → MetalLB가 사용할 VIP 등록]
#
# → MetalLB가 LoadBalancer Service에 할당할 IP를 등록한다.
# → 여기서는 ingress-nginx가 사용할 VIP 1개만 등록한다.
#
# [주의] MetalLB와 같은 네임스페이스에 있어야 한다.
# → 다른 네임스페이스에 만들면 MetalLB가 이 설정을 사용하지 않는다.
# ===============================================

apiVersion: metallb.io/v1beta1
kind: IPAddressPool

metadata:

  # → L2Advertisement가 사용할 IP Pool 이름이다.
  # → IPAddressPool과 L2Advertisement에서 같은 이름을 사용해야 한다.
  name: ${pool_name}

  # → MetalLB가 설치된 네임스페이스다.
  namespace: ${metallb_namespace}

spec:
  addresses:

    # → MetalLB가 사용할 VIP 주소다.
    # → /32는 IP 하나만 사용한다는 뜻이다.
    - ${vip}/32

  # → 자동으로 VIP를 할당하지 않는다.
  # → ingress-nginx처럼 VIP를 명시적으로 요청한 Service만 사용한다.
  #
  # → 다른 LoadBalancer Service가 실수로 이 VIP를 가져가는 것을 막는다.
  autoAssign: false