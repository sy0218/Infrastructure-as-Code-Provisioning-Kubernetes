# ===============================================
# [L2Advertisement → VIP 광고 설정]
#
# → IPAddressPool에 등록한 VIP를 네트워크에 광고한다.
# → L2 방식은 ARP를 사용해 VIP가 어느 노드에 있는지 알린다.
# → 현재 노드가 장애 나면 다른 노드가 VIP를 넘겨받는다.
#
# → interfaces는 노드마다 NIC 이름이 다를 수 있어 지정하지 않는다.
# ===============================================

apiVersion: metallb.io/v1beta1
kind: L2Advertisement

metadata:
  # → Pool 이름과 같은 이름을 쓴다 — 이 템플릿은 VIP(풀)마다 한 번씩 렌더된다.
  name: ${pool_name}
  namespace: ${metallb_namespace}

spec:
  # → 광고할 VIP가 들어있는 IPAddressPool
  ipAddressPools:
    - ${pool_name}