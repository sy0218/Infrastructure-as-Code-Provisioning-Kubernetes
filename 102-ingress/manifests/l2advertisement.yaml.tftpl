# ===============================================
# [L2Advertisement — VIP 를 광고하는 방식]
#   → L2 는 노드 한 대가 VIP 를 대표로 들고 ARP 에 응답하다가, 그 노드가 죽으면
#     다른 노드가 GARP 로 넘겨받는 액티브-스탠바이다(부하 분산이 아니라 장애 전환).
#   → BGP 가 아니라 L2 인 이유: 랩 네트워크가 VirtualBox host-only 라 피어링할 라우터가 없다.
#   ⚠ interfaces 를 적지 않는다 — 노드마다 NIC 이름이 다를 수 있고, 이 대역의 ARP 는
#     어차피 host-only 링크로만 들어온다.
# ===============================================
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: ingress-vip
  namespace: ${metallb_namespace}
spec:
  ipAddressPools:
    - ${pool_name}
