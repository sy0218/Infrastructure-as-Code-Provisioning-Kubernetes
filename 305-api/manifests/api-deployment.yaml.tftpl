# ===============================================
# [data-layer-api Deployment]
#   → 볼륨이 하나도 없다: 관리 화면 정적 파일과 airflow processor 는 이미지에 COPY 돼 있고,
#     docker.sock 마운트는 K8s API 어댑터로 대체됐다(노드마다 런타임 소켓 경로가 다르다).
# ===============================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: data-layer-api
  namespace: ${namespace}
  labels:
    app: data-layer-api
    app.kubernetes.io/name: data-layer-api
    app.kubernetes.io/part-of: data-layer
spec:
  replicas: ${replicas}
  selector:
    matchLabels:
      app: data-layer-api
  template:
    metadata:
      labels:
        app: data-layer-api
        app.kubernetes.io/name: data-layer-api
        app.kubernetes.io/part-of: data-layer
    spec:
      # Service env 자동 주입 차단 — 근거는 CLAUDE.md '쿠버네티스 규약'
      enableServiceLinks: false

      # ⚠ CoreDNS 는 노드 /etc/hosts 를 보지 않는다 — 파드 안에서 data-layer-grafana 는 NXDOMAIN 이다.
      #   그런데 '데이터 모니터링' 화면의 대시보드 목록은 이 API 가 대신 읽어야 하고(브라우저가
      #   직접 부르면 CORS), 그 대상은 브라우저용 GRAFANA_URL 하나뿐이다 → 같은 이름을 파드도
      #   풀 수 있게 클라이언트 PC hosts 와 같은 줄을 넣는다.
      #   노드 IP 3줄이 아니라 VIP 1줄인 이유: 장애 전환을 클라이언트의 재시도가 아니라
      #   MetalLB 가 하므로, 죽은 노드로 먼저 붙었다가 타임아웃을 기다릴 일이 없다.
      hostAliases:
        - ip: "${ingress_vip}"
          hostnames:
            - "${grafana_host}"

      # serviceAccountName 을 적지 않는다 → 네임스페이스의 default SA 를 쓴다.
      # 매퍼 재기동(파드 delete) 권한은 300-data-layer-base/permissions.tf 의 바인딩 하나가 그 SA 에 준다.
      containers:
        - name: api
          image: ${image}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: ${api_port}
          # 값의 출처는 300-data-layer-base 의 공용 오브젝트 하나뿐(이 스택은 참조만 한다).
          # CDM_OBJSTORE_* · COLLECTOR_DB_* · KAFKA_* · *_URL 이 전부 여기서 들어온다.
          envFrom:
            - configMapRef:
                name: data-layer-env
            - secretRef:
                name: data-layer-secrets
          env:
            # 이 워크로드만 쓰는 값이라 공용 ConfigMap 에 두지 않는다
            - name: DATA_LAYER_API_PORT
              value: "${api_port}"
            # K8s API 어댑터가 파드를 조회/삭제할 네임스페이스.
            # fieldRef 로 자기 자신에게서 읽으면 네임스페이스를 바꿔 재배포해도 손댈 곳이 없다.
            - name: DATA_LAYER_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
          # /health 는 무인증 경로다(그 외 /api/* 는 X-API-Key 필수) → 프로브에 키가 필요 없다
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 30
            periodSeconds: 20
            failureThreshold: 6
