# ===============================================
# [Kafka Connect — Service]
#   → 커넥터를 등록·조회하는 REST 창구.
#   → 이 주소가 공용 ConfigMap 의 KAFKA_CONNECT_URL 이 된다.
# ===============================================
apiVersion: v1
kind: Service
metadata:
  # 이름이 계약이다 — 공용 ConfigMap 의 KAFKA_CONNECT_URL 이 이 주소를 가리킨다
  name: cdc-connect
  namespace: ${namespace}
  labels:
    app: cdc-connect
    app.kubernetes.io/name: cdc-connect
    app.kubernetes.io/part-of: data-layer
spec:
  # 아무 워커나 받으면 된다 — 비리더는 리더에게 넘긴다.
  # 그 '넘기는 주소'가 Deployment 의 podIP 광고다(둘은 한 쌍으로만 동작한다).
  type: ClusterIP
  selector:
    app: cdc-connect
  ports:
    - name: rest
      port: ${rest_port}
      targetPort: rest
