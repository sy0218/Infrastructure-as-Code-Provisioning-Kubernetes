# ===============================================
# [CDM Consumer — Deployment]
#   → cdm-topic 을 읽어 목적지(RDB·Graph·Warehouse)에 적재한다.
#   → 목적지별로 for_each 로 3벌이 찍힌다 — 차이는 env 뿐이다.
# ===============================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${name}
  namespace: ${namespace}
  labels:
    app: ${name}
    app.kubernetes.io/name: ${name}
    app.kubernetes.io/component: cdm-consumer
    app.kubernetes.io/part-of: data-layer
spec:
  replicas: ${replicas}
  selector:
    matchLabels:
      app: ${name}
  template:
    metadata:
      labels:
        app: ${name}
        app.kubernetes.io/name: ${name}
        app.kubernetes.io/component: cdm-consumer
        app.kubernetes.io/part-of: data-layer
    spec:
      # Service env 자동 주입 차단 — 근거는 CLAUDE.md '쿠버네티스 규약'
      enableServiceLinks: false

      # 마이크로배치 중 SIGTERM 을 받으면 커밋까지 마치고 나가야 한다(근거는 variables.tf)
      terminationGracePeriodSeconds: ${termination_grace_seconds}
      # nodeSelector 없음 — 노드에 묶일 이유가 없어 배치는 스케줄러에 위임한다
      containers:
        - name: ${name}
          image: ${image}
          imagePullPolicy: IfNotPresent
          # 공유 값과 종류별 노브(CDM_CONSUMER_<종류>_GROUP·DLQ_TOPIC·BATCH_* 등)가
          # 전부 공용 ConfigMap 에 같은 이름으로 있다 → 여기 다시 적지 않는다.
          envFrom:
            - configMapRef:
                name: data-layer-env
            - secretRef:
                name: data-layer-secrets
          # 이름이 어긋나는 값만 옮겨 담은 한 줄(rdb 는 옮길 것이 없어 줄 자체가 사라진다) — 조립은 consumers.tf
          ${env_block}
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
          # probe 없음 — 리슨 포트가 없고, 섣부른 liveness 는 배치 커밋 중인 워커를 죽인다.
          # 이상 감지는 컨슈머 그룹 lag(kafka-exporter → Prometheus)이 담당한다.
