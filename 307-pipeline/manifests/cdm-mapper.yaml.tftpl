# ===============================================
# [CDM Mapper — Deployment]
#   → 원천 메시지를 공통 데이터 모델(CDM)로 변환해 cdm-topic 에 넣는다.
#   → 도메인 모듈별로 for_each 로 찍힌다. 변환 규칙은 MinIO 의 config/*.yaml 에서 읽는다.
# ===============================================
apiVersion: apps/v1
kind: Deployment
metadata:
  # 스네이크 모듈명 → 케밥 변환은 렌더링하는 쪽(mappers.tf)이 끝내고 넘긴다
  name: ${deployment_name}
  namespace: ${namespace}
  labels:
    app: cdm-mapper
    cdm.mapper/module: ${module}
    app.kubernetes.io/name: cdm-mapper
    app.kubernetes.io/part-of: data-layer
spec:
  replicas: ${replicas}
  selector:
    matchLabels:
      app: cdm-mapper
      cdm.mapper/module: ${module}
  template:
    metadata:
      labels:
        # ⚠ 이 두 라벨은 data-layer-api 와의 계약이다. DQ 규칙 적용 시 API 가
        #   app=cdm-mapper + cdm.mapper/module=<모듈> 로 재기동 대상을 고른다.
        #   라벨을 바꾸면 API 는 '대상 0건'으로 조용히 성공한다(화면상 실패가 아니다).
        app: cdm-mapper
        cdm.mapper/module: ${module}
        app.kubernetes.io/name: cdm-mapper
        app.kubernetes.io/part-of: data-layer
    spec:
      # Service env 자동 주입 차단 — 근거는 CLAUDE.md '쿠버네티스 규약'
      enableServiceLinks: false

      # DQ 적용 = API 가 이 파드를 delete → 매퍼가 진행 중 배치를 드레인하고 종료.
      # ⚠ ConfigMap 의 DATA_QUALITY_RESTART_DRAIN_TIMEOUT 과 커플링 — variables.tf 참고.
      terminationGracePeriodSeconds: ${termination_grace_seconds}
      # nodeSelector 없음 — 순수 컨슈머라 배치는 스케줄러에 위임한다
      containers:
        - name: cdm-mapper
          image: ${image}
          imagePullPolicy: IfNotPresent
          # 이미지 하나에 매퍼 8종이 들어 있고 실행할 모듈만 command 로 갈린다
          command: ["python", "-m", "cdm.data_layer_mappers.${module}"]
          # 매퍼가 읽는 값은 전부 300-data-layer-base 의 공용 오브젝트에 있다
          # (KAFKA_BOOTSTRAP / SCHEMA_REGISTRY_URL / CDM_TOPIC / *_DLQ_TOPIC / CDM_OBJSTORE_* 등)
          envFrom:
            - configMapRef:
                name: data-layer-env
            - secretRef:
                name: data-layer-secrets
          env:
            # 공용 ConfigMap 의 LOG_LEVEL 을 한 워크로드가 독점할 수 없어 매퍼 전용 키에서 이름만 옮겨 담는다
            - name: LOG_LEVEL
              valueFrom:
                configMapKeyRef:
                  name: data-layer-env
                  key: CDM_MAPPER_LOG_LEVEL
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
          # probe 없음 — 리슨 포트가 없고, 섣부른 liveness 는 드레인 중인 매퍼를 죽여 배치를 자른다.
          # 이상 감지는 kafka-exporter 의 컨슈머 그룹 lag(Prometheus)이 담당한다.
