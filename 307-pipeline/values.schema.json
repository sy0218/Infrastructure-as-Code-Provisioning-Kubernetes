{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pipeline values",
  "description": "이 차트가 실제로 참조하는 키만 required 로 선언한다(values.common.yaml 을 -f 로 주지 않으면 렌더 전에 실패).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "global",
    "mapper",
    "consumer",
    "lineage",
    "tcpSocket"
  ],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "namespace",
        "harborRegistry",
        "imageTag",
        "hadoop",
        "nodes"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "harborRegistry": {
          "type": "string",
          "pattern": "^[a-z0-9]([-.a-z0-9]*[a-z0-9])?(:[0-9]+)?$"
        },
        "imageTag": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "description": "클러스터 노드 표 — hdfs-site 의 NameNode 주소(namenode.nodeNames → IP)를 여기서 찾는다. 이름·IP 중복 금지",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "ip"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "kubernetes.io/hostname 값 — hadoop.namenode.nodeNames 가 이 이름을 가리킨다",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "ip": {
                "type": "string",
                "description": "노드 IP (301-hadoop 이 hostNetwork 라 곧 NameNode RPC 주소)",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$"
              }
            }
          }
        },
        "hadoop": {
          "type": "object",
          "additionalProperties": true,
          "description": "301-hadoop 서버 설정과 같은 원본 — 이 차트는 warehouse 컨슈머의 클라이언트 core-site/hdfs-site 와 HADOOP_USER_NAME 조립에 쓰는 키만 본다",
          "required": [
            "nameservice",
            "namenode",
            "ports",
            "warehouse"
          ],
          "properties": {
            "nameservice": {
              "type": "string",
              "description": "HDFS HA 논리 이름 — fs.defaultFS(hdfs://<nameservice>)·dfs.nameservices 가 된다",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "namenode": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "nodeNames"
              ],
              "properties": {
                "nodeNames": {
                  "type": "array",
                  "description": "NameNode 를 띄운 노드 이름(global.nodes 의 name) — 인덱스가 NameNode id(nn<i>)가 된다. 301-hadoop 이 같은 global 값을 읽으므로 서버와 같은 id·주소가 나온다",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "ports": {
              "type": "object",
              "additionalProperties": true,
              "description": "dfs.namenode.rpc-address 에 들어가는 namenodeRpc 만 본다 — 나머지 포트는 301-hadoop 이 검증",
              "required": [
                "namenodeRpc"
              ],
              "properties": {
                "namenodeRpc": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "warehouse": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "user"
              ],
              "properties": {
                "user": {
                  "type": "string",
                  "description": "HDFS 실행 사용자(HADOOP_USER_NAME) — 301-hadoop 이 warehouse.path 를 이 사용자 소유로 만든다(OS 계정 아님, simple auth)",
                  "pattern": "^[a-z_][a-z0-9_-]*$"
                }
              }
            }
          }
        }
      }
    },
    "mapper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "terminationGracePeriodSeconds",
        "modules"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "파이썬 모듈명 (스네이크)"
          }
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "terminationGracePeriodSeconds",
        "kinds"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "kinds": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "image"
            ],
            "properties": {
              "image": {
                "type": "string",
                "minLength": 1
              },
              "fromConfigMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "fromSecret": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "hdfs": {
                "type": "boolean",
                "description": "true 면 hdfs-client-config 를 /etc/hadoop/conf 에 마운트하고 HADOOP_USER_NAME(global.hadoop.warehouse.user)·HADOOP_CONF_DIR 을 env 로 준다 — 데이터 파일을 HDFS 에 쓰는 종류(warehouse)만"
              }
            }
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tcpSocket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeNames"
      ],
      "properties": {
        "nodeNames": {
          "type": "array",
          "description": "tcp-socket-collector 를 띄울 노드 후보(global.nodes 의 name) — nodeAffinity In 으로 들어간다",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
