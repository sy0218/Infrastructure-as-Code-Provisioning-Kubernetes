# 로컬 Kafka 브로커(ADR 0 — Ansible kafka 롤 설치) — host.yml kafka 그룹 노드 IP × 9092
# 저장소 전체에서 브로커 주소를 적는 유일한 곳이다 — 301 은 공용 ConfigMap 을 읽는다.
kafka_bootstrap_servers = "192.168.56.200:9092,192.168.56.201:9092,192.168.56.202:9092"

# 로컬 데이터 스토어(브로커와 같은 노드 로컬 설치 — Ansible, 추후 작성)
# 설치 노드가 확정되면 실제 설치 위치와 맞출 것.
minio_endpoint = "http://192.168.56.200:9000"
postgres_host  = "192.168.56.200"
neo4j_bolt_uri = "bolt://192.168.56.200:7687"
