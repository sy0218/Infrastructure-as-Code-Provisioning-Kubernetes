{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "data-layer-base values",
  "description": "이 차트가 global 에서 실제로 참조하는 키만 required 로 선언한다 — values.common.yaml 을 -f 로 주지 않으면 렌더 전에 실패한다. global 에는 다른 차트용 키도 함께 들어오므로 additionalProperties 를 막지 않는다.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "global",
    "graphLabelPrefix"
  ],
  "properties": {
    "graphLabelPrefix": {
      "type": "string",
      "description": "빈 문자열 허용 — 실서비스는 빈 값, 검증 단계는 Test"
    },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "namespace",
        "kafka",
        "postgres",
        "minioEndpoint",
        "neo4jBoltUri",
        "hosts",
        "secrets"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "description": "RFC 1123 라벨 — 소문자/숫자/하이픈만",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "kafka": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "brokers",
            "ports",
            "schemaRegistryPort",
            "connectPort",
            "name",
            "controllers",
            "replicationFactor",
            "minInsyncReplicas",
            "numPartitions",
            "data",
            "metadata"
          ],
          "properties": {
            "brokers": {
              "type": "array",
              "description": "Broker 를 띄울 노드 표 — 쿠버네티스 전체 노드가 아니라 의도적으로 고른 부분집합. 목록 길이 = replicas, 인덱스 = 브로커 ID = 파드 ordinal. 이름·IP 중복 금지. bootstrap 주소도 이 표에서 조립된다",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "ip"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "kubernetes.io/hostname 값 (PV nodeAffinity)",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                  },
                  "ip": {
                    "type": "string",
                    "description": "노드 IP (hostNetwork 광고 주소·voters·bootstrap)",
                    "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$"
                  }
                }
              }
            },
            "ports": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "client",
                "interBroker",
                "controller",
                "jmx"
              ],
              "properties": {
                "client": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "interBroker": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "controller": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "jmx": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "schemaRegistryPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "connectPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "name": {
              "type": "string",
              "description": "StatefulSet 이름 → 파드 kafka-N, ConfigMap <name>-config (브로커는 hostNetwork 라 Service 없음)",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 40
            },
            "controllers": {
              "type": "integer",
              "description": "brokers 앞에서부터 controller+broker 겸용으로 둘 개수 — 홀수(3 또는 5). 정적 쿼럼이라 생성 후 변경은 전 브로커 롤링",
              "enum": [
                3,
                5
              ]
            },
            "replicationFactor": {
              "type": "integer",
              "minimum": 1
            },
            "minInsyncReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "numPartitions": {
              "type": "integer",
              "minimum": 1
            },
            "data": {
              "$ref": "#/definitions/localVolume"
            },
            "metadata": {
              "$ref": "#/definitions/localVolume"
            }
          }
        },
        "postgres": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "clusterName",
            "port",
            "schema",
            "databases"
          ],
          "properties": {
            "clusterName": {
              "type": "string",
              "description": "접속 호스트 <clusterName>-rw.<ns>.svc.cluster.local 이 여기서 파생된다",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "databases": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "collector",
                "airflow",
                "icebergCatalog"
              ],
              "properties": {
                "collector": {
                  "type": "string",
                  "minLength": 1
                },
                "airflow": {
                  "type": "string",
                  "minLength": 1
                },
                "icebergCatalog": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "minioEndpoint": {
          "type": "string",
          "pattern": "^https?://.+",
          "description": "301-minio 의 ClusterIP Service FQDN(http://minio.<ns>.svc.cluster.local:<ports.api>) — MINIO_S3_ENDPOINT·CDM_OBJSTORE_ENDPOINT 가 된다. 소비자가 전부 파드라 노드 IP 를 넣지 않는다"
        },
        "neo4jBoltUri": {
          "type": "string",
          "pattern": "^bolt(\\+s(sc)?)?://.+"
        },
        "hosts": {
          "type": "object",
          "additionalProperties": true,
          "description": "호스트명 라벨 — 밑줄 금지(원본 '호스트명에 밑줄을 쓰지 않는다' 규칙)",
          "required": [
            "kafkaUi",
            "airflow",
            "grafana"
          ],
          "properties": {
            "kafkaUi": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "airflow": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "grafana": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          }
        },
        "secrets": {
          "type": "object",
          "description": "Secret data-layer-secrets 의 원천 — 키 오타가 조용히 기본값으로 남지 않도록 추가 키를 막는다",
          "additionalProperties": false,
          "required": [
            "minioUser",
            "minioPassword",
            "postgresUser",
            "postgresPassword",
            "neo4jUser",
            "neo4jPassword",
            "grafanaAdminUser",
            "grafanaAdminPassword",
            "collectorCryptoKey",
            "dataLayerApiKey"
          ],
          "properties": {
            "minioUser": {
              "type": "string",
              "minLength": 1
            },
            "minioPassword": {
              "type": "string",
              "minLength": 1
            },
            "postgresUser": {
              "type": "string",
              "minLength": 1
            },
            "postgresPassword": {
              "type": "string",
              "minLength": 1
            },
            "neo4jUser": {
              "type": "string",
              "minLength": 1
            },
            "neo4jPassword": {
              "type": "string",
              "minLength": 1
            },
            "grafanaAdminUser": {
              "type": "string",
              "minLength": 1
            },
            "grafanaAdminPassword": {
              "type": "string",
              "minLength": 1
            },
            "collectorCryptoKey": {
              "type": "string",
              "minLength": 1
            },
            "dataLayerApiKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "definitions": {
    "localVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "노드의 절대 경로 — Ansible group_vars/kafka.yml 과 글자 그대로 같아야 한다",
          "pattern": "^/[^\\s]+$"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi|Ti)$"
        }
      }
    }
  }
}
