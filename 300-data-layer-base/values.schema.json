{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "data-layer-base values",
  "description": "이 차트가 global 에서 실제로 참조하는 키만 required 로 선언한다 — values.common.yaml 을 -f 로 주지 않으면 렌더 전에 실패한다. global 에는 다른 차트용 키도 함께 들어오므로 additionalProperties 를 막지 않는다.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "global"
  ],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "namespace",
        "kafka",
        "postgres",
        "minioEndpoint",
        "minioBuckets",
        "hadoop",
        "neo4jBoltUri",
        "hosts",
        "secrets"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "description": "RFC 1123 라벨 — 소문자/숫자/하이픈만",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "kafka": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "brokers",
            "ports",
            "schemaRegistryPort",
            "connectPort"
          ],
          "properties": {
            "brokers": {
              "type": "array",
              "description": "Broker 를 띄울 노드 표(정본은 301-kafka) — 이 차트는 KAFKA_BOOTSTRAP 조립에만 쓴다. 이름·IP 중복 금지",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "ip"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "kubernetes.io/hostname 값 (PV nodeAffinity)",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                  },
                  "ip": {
                    "type": "string",
                    "description": "노드 IP (hostNetwork 라 곧 bootstrap 주소)",
                    "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$"
                  }
                }
              }
            },
            "ports": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "client"
              ],
              "properties": {
                "client": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "description": "KAFKA_BOOTSTRAP 에 들어가는 client 포트만 본다 — 나머지 브로커 포트는 301-kafka 가 검증"
            },
            "schemaRegistryPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "connectPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "postgres": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "clusterName",
            "port",
            "schema",
            "databases"
          ],
          "properties": {
            "clusterName": {
              "type": "string",
              "description": "접속 호스트 <clusterName>-rw.<ns>.svc.cluster.local 이 여기서 파생된다",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "databases": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "collector",
                "airflow",
                "icebergCatalog"
              ],
              "properties": {
                "collector": {
                  "type": "string",
                  "minLength": 1
                },
                "airflow": {
                  "type": "string",
                  "minLength": 1
                },
                "icebergCatalog": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "minioEndpoint": {
          "type": "string",
          "pattern": "^https?://.+",
          "description": "301-minio 의 ClusterIP Service FQDN(http://minio.<ns>.svc.cluster.local:<ports.api>) — CDM_OBJSTORE_ENDPOINT 가 된다(설정 버킷 전용, Iceberg 데이터 파일은 301-hadoop HDFS). 소비자가 전부 파드라 노드 IP 를 넣지 않는다"
        },
        "minioBuckets": {
          "type": "object",
          "additionalProperties": true,
          "description": "버킷 이름 정본 — 301-minio 의 hook Job 이 전부 만든다. 이 차트는 config 만 읽는다(CDM_OBJSTORE_BUCKET)",
          "required": ["config"],
          "properties": {
            "config": { "type": "string", "pattern": "^[a-z0-9][-a-z0-9]{1,61}[a-z0-9]$" }
          }
        },
        "hadoop": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "nameservice",
            "warehouse"
          ],
          "properties": {
            "nameservice": {
              "type": "string",
              "description": "HDFS HA 논리 이름 — 301-hadoop 의 fs.defaultFS(hdfs://<nameservice>)와 같은 원본. ICEBERG_WAREHOUSE 의 authority 자리에 들어간다",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "warehouse": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "description": "HDFS 절대 경로 — ICEBERG_WAREHOUSE = hdfs://<nameservice><path>. 301-hadoop 의 hadoop-dirs Job 이 만들고 307 이 그 소유자로 쓴다",
                  "pattern": "^/[^\\s]+$"
                }
              }
            }
          }
        },
        "neo4jBoltUri": {
          "type": "string",
          "pattern": "^bolt(\\+s(sc)?)?://.+"
        },
        "hosts": {
          "type": "object",
          "additionalProperties": true,
          "description": "호스트명 라벨 — 밑줄 금지(원본 '호스트명에 밑줄을 쓰지 않는다' 규칙)",
          "required": [
            "kafkaUi",
            "airflow",
            "grafana"
          ],
          "properties": {
            "kafkaUi": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "airflow": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "grafana": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          }
        },
        "secrets": {
          "type": "object",
          "description": "Secret data-layer-secrets 의 원천 — 키 오타가 조용히 기본값으로 남지 않도록 추가 키를 막는다",
          "additionalProperties": false,
          "required": [
            "minioUser",
            "minioPassword",
            "postgresUser",
            "postgresPassword",
            "neo4jUser",
            "neo4jPassword",
            "grafanaAdminUser",
            "grafanaAdminPassword",
            "collectorCryptoKey",
            "dataLayerApiKey"
          ],
          "properties": {
            "minioUser": {
              "type": "string",
              "minLength": 1
            },
            "minioPassword": {
              "type": "string",
              "minLength": 1
            },
            "postgresUser": {
              "type": "string",
              "minLength": 1
            },
            "postgresPassword": {
              "type": "string",
              "minLength": 1
            },
            "neo4jUser": {
              "type": "string",
              "minLength": 1
            },
            "neo4jPassword": {
              "type": "string",
              "minLength": 1
            },
            "grafanaAdminUser": {
              "type": "string",
              "minLength": 1
            },
            "grafanaAdminPassword": {
              "type": "string",
              "minLength": 1
            },
            "collectorCryptoKey": {
              "type": "string",
              "minLength": 1
            },
            "dataLayerApiKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
