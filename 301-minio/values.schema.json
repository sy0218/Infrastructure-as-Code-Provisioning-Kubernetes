{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "minio values",
  "description": "이 차트가 실제로 참조하는 키만 required 로 선언한다(values.common.yaml 을 -f 로 주지 않으면 렌더 전에 실패). global 에는 다른 차트용 키도 함께 들어오므로 additionalProperties 를 막지 않는다.",
  "type": "object",
  "additionalProperties": true,
  "required": ["global", "ports", "storage", "tolerationSeconds", "expireDays"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "required": ["namespace", "harborRegistry", "imageTag", "minioBuckets"],
      "properties": {
        "namespace": {
          "type": "string",
          "description": "RFC 1123 라벨 — 소유자는 300-data-layer-base",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "harborRegistry": {
          "type": "string",
          "description": "스킴 없는 레지스트리 주소",
          "pattern": "^[a-z0-9]([-.a-z0-9]*[a-z0-9])?(:[0-9]+)?$"
        },
        "imageTag": {
          "type": "string",
          "description": "공용 이미지 태그 — build_and_push.sh 에 준 태그와 같아야 한다",
          "minLength": 1
        },
        "minioBuckets": {
          "type": "object",
          "description": "hook Job minio-buckets 가 mc mb -p 로 만드는 버킷 — 키는 역할(config·airflowLogs), 값은 이름. 소비자(300 CDM_OBJSTORE_BUCKET · 304 태스크 로그)가 같은 값을 읽는다. 여기서 빼도 Job 은 지우지 않는다",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "description": "S3 버킷 이름 규칙 중 이 저장소 규칙 — 소문자/숫자/하이픈 3~63자, 점 금지(호스트명과 혼동)",
            "pattern": "^[a-z0-9][-a-z0-9]{1,61}[a-z0-9]$"
          }
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api"],
      "properties": {
        "api": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageClass", "size"],
      "properties": {
        "storageClass": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki)$" }
      }
    },
    "tolerationSeconds": {
      "type": "integer",
      "description": "노드 NotReady 판정 후 파드 퇴거까지 대기 시간(초) — k8s 기본 300",
      "minimum": 0
    },
    "expireDays": {
      "type": "object",
      "description": "버킷별 ILM 만료 일수 — 키는 global.minioBuckets 의 키(없는 키면 렌더가 실패). 로그처럼 계속 쌓이는 버킷만 두고, 빼면 Job 이 ILM 을 걷어낸다",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    }
  }
}
