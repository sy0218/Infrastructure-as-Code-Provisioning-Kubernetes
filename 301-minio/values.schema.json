{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "minio values",
  "description": "이 차트가 실제로 참조하는 키만 required 로 선언한다(values.common.yaml 을 -f 로 주지 않으면 렌더 전에 실패). global 에는 다른 차트용 키도 함께 들어오므로 additionalProperties 를 막지 않는다.",
  "type": "object",
  "additionalProperties": true,
  "required": ["global", "ports", "storage", "tolerationSeconds"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "required": ["namespace", "harborRegistry", "imageTag"],
      "properties": {
        "namespace": {
          "type": "string",
          "description": "RFC 1123 라벨 — 소유자는 300-data-layer-base",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "harborRegistry": {
          "type": "string",
          "description": "스킴 없는 레지스트리 주소",
          "pattern": "^[a-z0-9]([-.a-z0-9]*[a-z0-9])?(:[0-9]+)?$"
        },
        "imageTag": {
          "type": "string",
          "description": "공용 이미지 태그 — build_and_push.sh 에 준 태그와 같아야 한다",
          "minLength": 1
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api"],
      "properties": {
        "api": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageClass", "size"],
      "properties": {
        "storageClass": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki)$" }
      }
    },
    "tolerationSeconds": {
      "type": "integer",
      "description": "노드 NotReady 판정 후 파드 퇴거까지 대기 시간(초) — k8s 기본 300",
      "minimum": 0
    }
  }
}
