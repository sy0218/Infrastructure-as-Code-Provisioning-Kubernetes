# ===============================================
# [Kafka UI — 브라우저 진입점]
#   → 102-ingress 의 VIP 로 들어온 요청 중 Host 가 이 이름인 것만 아래 Service 로 간다.
#   → 경로가 아니라 호스트로 가르는 이유: 경로 기반이면 앱마다 base path 설정을
#     따로 넣어야 하는데, 호스트 기반은 앱이 자기가 루트에 있다고 믿어도 그대로 동작한다.
# ===============================================
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: kafka-ui
  namespace: ${namespace}
  labels:
    app: kafka-ui
    app.kubernetes.io/name: kafka-ui
    app.kubernetes.io/part-of: data-layer
spec:
  # 차트가 이 클래스를 기본값으로 만들지 않으므로 생략하면 어떤 컨트롤러도 집어 가지 않는다
  ingressClassName: nginx
  rules:
    - host: ${host}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: kafka-ui
                port:
                  number: ${http_port}
