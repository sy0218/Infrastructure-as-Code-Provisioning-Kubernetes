{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kafka-tools values",
  "description": "원본 301-kafka-tools 의 'default 없는 변수 = tfvars 강제' 규칙의 Helm 판 — 필수 키 누락·오타·형식 오류를 렌더(lint/template/install) 시점에 잡는다. global 은 루트가 다른 차트용 키까지 통짜로 주입하므로 additionalProperties 를 막지 않는다.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "global",
    "schemaRegistryReplicas",
    "schemaRegistryPort",
    "kafkaUiPort",
    "kafkaExporterPort",
    "kafkaUiHost"
  ],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "required": ["namespace", "harborRegistry", "imageTag", "ingressClassName", "kafkaBootstrap"],
      "properties": {
        "namespace": {
          "type": "string",
          "description": "RFC 1123 라벨 — 소문자/숫자/하이픈만",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "harborRegistry": {
          "type": "string",
          "description": "스킴 없음·밑줄 금지 — Docker 이미지 참조 파서가 밑줄 든 domain 을 거부한다",
          "pattern": "^[a-z0-9]([-.a-z0-9]*[a-z0-9])?(:[0-9]+)?$"
        },
        "imageTag": {
          "type": "string",
          "description": "git SHA 기반 불변 태그",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "ingressClassName": {
          "type": "string",
          "minLength": 1
        },
        "kafkaBootstrap": {
          "type": "string",
          "description": "쉼표 구분 host:port 목록 — 300-data-layer-base 의 값과 일치해야 한다 (호스트에 콜론 금지 → PLAINTEXT:// 접두사 실수를 렌더 시점에 차단)",
          "pattern": "^[^,\\s:]+:[0-9]+(,[^,\\s:]+:[0-9]+)*$"
        }
      }
    },
    "schemaRegistryReplicas": { "type": "integer", "minimum": 1 },
    "schemaRegistryPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "kafkaUiPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "kafkaExporterPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "kafkaUiHost": {
      "type": "string",
      "description": "호스트명 라벨 — 밑줄 금지(원본 '호스트명에 밑줄을 쓰지 않는다' 규칙)",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    }
  }
}
